\":216000,\"coverNote\":\"Em có thế mạnh phương pháp tư duy logic và giải toán trắc nghiệm nhanh, sẵn sàng kèm học thử 1 buổi.\",\"status\":\"pending\",\"createdAt\":\"2026-10-03T15:40:00+07:00\"},{\"id\":\"prop-203\",\"classPostId\":\"post-102\",\"tutorId\":\"thao-vy\",\"tutorName\":\"Lê Thảo Vy\",\"tutorUniversity\":\"ĐH Ngoại Thương TP.HCM (Kinh tế Đối ngoại)\",\"tutorRating\":5,\"tutorPunctualityRate\":100,\"hasStudentBadge\":true,\"tier\":\"top_rated\",\"proposedFee\":250000,\"platformFee\":17500,\"netPayout\":232500,\"coverNote\":\"IELTS 8.0, kinh nghiệm luyện thi vào lớp 10 các trường chuyên Lê Hồng Phong, Trần Đại Nghĩa.\",\"status\":\"pending\",\"createdAt\":\"2026-10-04T16:10:00+07:00\"}],\"chatThreads\":[{\"id\":\"thread-001\",\"learnerId\":\"demo-learner\",\"tutorId\":\"demo-tutor\",\"learnerName\":\"Nguyễn Minh Anh\",\"tutorName\":\"Trần Gia Bảo\",\"lastMessageText\":\"Gia sư vừa gửi đề xuất học phí: 220.000 đ/buổi (2 buổi/tuần)\",\"lastMessageAt\":\"2026-10-04T15:10:00+07:00\",\"unreadCountLearner\":1,\"unreadCountTutor\":0}],\"messages\":[{\"id\":\"msg-001\",\"threadId\":\"thread-001\",\"senderId\":\"demo-learner\",\"senderName\":\"Nguyễn Minh Anh\",\"senderRole\":\"learner\",\"text\":\"Chào bạn Bảo, bé nhà mình hiện đang bị hổng phần hình học lớp 8, bạn có thể kèm tuần 2 buổi được không?\",\"type\":\"text\",\"offerData\":null,\"createdAt\":\"2026-10-04T14:45:00+07:00\"},{\"id\":\"msg-002\",\"threadId\":\"thread-001\",\"senderId\":\"demo-tutor\",\"senderName\":\"Trần Gia Bảo\",\"senderRole\":\"tutor\",\"text\":\"Dạ chào chị Minh Anh! Em hoàn toàn sắp xếp được lịch vào tối Thứ 3 và Thứ 5 ạ. Em sẽ mang theo giáo án chuyên biệt để test năng lực buổi đầu cho bé.\",\"type\":\"text\",\"offerData\":null,\"createdAt\":\"2026-10-04T15:00:00+07:00\"},{\"id\":\"msg-003\",\"threadId\":\"thread-001\",\"senderId\":\"demo-tutor\",\"senderName\":\"Trần Gia Bảo\",\"senderRole\":\"tutor\",\"text\":\"Đề xuất kế hoạch học tập môn Toán 8\",\"type\":\"custom_offer\",\"offe