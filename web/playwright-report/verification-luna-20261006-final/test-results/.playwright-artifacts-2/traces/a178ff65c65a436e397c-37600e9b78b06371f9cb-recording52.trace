rần Thu Hà\",\"subject\":\"Tiếng Anh\",\"grade\":\"Lớp 9\",\"format\":\"online\",\"location\":\"Toàn quốc (Online)\",\"address\":\"Học qua Google Meet\",\"scheduleDesc\":\"Thứ 2, Thứ 4, Thứ 6 (19:30 - 21:00)\",\"budgetMode\":\"range\",\"budgetAmount\":250000,\"minBudget\":220000,\"maxBudget\":280000,\"trialLessonRequested\":false,\"learningGoal\":\"Luyện đề thi tuyển sinh vào lớp 10 chuyên Anh\",\"status\":\"open\",\"moderationStatus\":\"approved\",\"createdAt\":\"2026-10-04T14:30:00+07:00\",\"proposalCount\":1},{\"id\":\"post-103\",\"learnerId\":\"demo-learner-3\",\"learnerName\":\"Lê Hoàng Nam\",\"subject\":\"Vật lý\",\"grade\":\"Lớp 11\",\"format\":\"offline\",\"location\":\"Quận 3, TP. Hồ Chí Minh\",\"address\":\"45 Võ Văn Tần, P.6, Quận 3\",\"scheduleDesc\":\"Thứ 7 & Chủ nhật (09:00 - 10:30)\",\"budgetMode\":\"negotiable\",\"budgetAmount\":300000,\"minBudget\":250000,\"maxBudget\":350000,\"trialLessonRequested\":true,\"learningGoal\":\"Nắm vững kiến thức điện xoay chiều và dao động điều hòa\",\"status\":\"open\",\"moderationStatus\":\"approved\",\"createdAt\":\"2026-10-05T08:15:00+07:00\",\"proposalCount\":0}],\"proposals\":[{\"id\":\"prop-201\",\"classPostId\":\"post-101\",\"tutorId\":\"demo-tutor\",\"tutorName\":\"Trần Gia Bảo\",\"tutorUniversity\":\"ĐH Sư Phạm TP.HCM (Sư phạm Toán)\",\"tutorRating\":4.9,\"tutorPunctualityRate\":99,\"hasStudentBadge\":true,\"tier\":\"top_rated\",\"proposedFee\":220000,\"platformFee\":22000,\"netPayout\":198000,\"coverNote\":\"Chào phụ huynh, em là sinh viên năm 3 Sư Phạm Toán, đã có 2 năm kinh nghiệm dạy kèm toán 8-9 lấy lại căn bản rất nhanh.\",\"status\":\"pending\",\"createdAt\":\"2026-10-03T11:20:00+07:00\"},{\"id\":\"prop-202\",\"classPostId\":\"post-101\",\"tutorId\":\"mai-anh\",\"tutorName\":\"Nguyễn Mai Anh\",\"tutorUniversity\":\"ĐH Bách Khoa TP.HCM (Khoa học Máy tính)\",\"tutorRating\":4.8,\"tutorPunctualityRate\":97,\"hasStudentBadge\":true,\"tier\":\"pro\",\"proposedFee\":240000,\"platformFee\":24000,\"netPayout\":216000,\"coverNote\":\"Em có thế mạnh phương pháp tư duy logic và giải toán trắc nghiệm nhanh, sẵn sàng kèm học thử 1 buổi.\",\"status\":\"pending\",\"createdAt\":\"2026-10-03T15:40:00+07:00\"},{\"id\":\"prop-203\",\"classPostId\":\"post-102\",\"tutorId\":\"thao-vy\",\"tutorName\":\"Lê Thảo Vy\",\"tutorUniversity\":\"ĐH Ngoại Thương TP.HCM (Kinh tế Đối ngoại)\",\"tutorRating\":5,\"tutorPunctualityRate\":100,\"hasStudentBadge\":true,\"tier\":\"top_rated\",\"proposedFee\":250000,\"platformFee\":17500,\"netPayout\":232500,\"coverNote\":\"IELTS 8.0, kinh nghiệm luyện thi vào lớp 10 các trường chuyên Lê Hồng Phong, Trần Đại Nghĩa.\",\"status\":\"pending\",\"createdAt\":\"2026-10-04T16:10:00+07:00\"}],\"chatThreads\":[{\"id\":\"thread-001\",\"learnerId\":\"demo-learner\",\"tutorId\":\"demo-tutor\",\"learnerName\":\"Nguyễn Minh Anh\",\"tutorName\":\"Trần Gia Bảo\",\"lastMessageText\":\"Gia sư vừa gửi đề xuất học phí: 220.000 đ/buổi (2 buổi/tuần)\",\"lastMessageAt\":\"2026-10-04T15:10:00+07:00\",\"unreadCountLearner\":1,\"unreadCountTutor\":0}],\"messages\":[{\"id\":\"msg-001\",\"threadId\":\"thread-001\",\"senderId\":\"demo-learner\",\"senderName\":\"Nguyễn Minh Anh\",\"senderRole\":\"learner\",\"text\":\"Chào bạn Bảo, bé nhà mình hiện đang bị hổng phần hình học lớp 8, bạn có thể kèm tuần 2 buổi được không?\",\"type\":\"text\",\"offerData\":null,\"createdAt\":\"2026-10-04T14:45:00+07:00\"},{\"id\":\"msg-002\",\"threadId\":\"thread-001\",\"senderId\":\"demo-tutor\",\"senderName\":\"Trần Gia Bảo\",\"senderRole\":\"tutor\",\"text\":\"Dạ chào chị Minh Anh! Em hoàn toàn sắp xếp được lịch vào tối Thứ 3 và Thứ 5 ạ. Em sẽ mang theo giáo án chuyên biệt để test năng lực buổi đầu cho bé.\",\"type\":\"text\",\"offerData\":null,\"createdAt\":\"2026-10-04T15:00:00+07:00\"},{\"id\":\"msg-003\",\"threadId\":\"thread-001\",\"senderId\":\"demo-tutor\",\"senderName\":\"Trần Gia Bảo\",\"senderRole\":\"tutor\",\"text\":\"Đề xuất kế hoạch học tập môn Toán 8\",\"type\":\"custom_offer\",\"offerData\":{\"id\":\"offer-301\",\"subject\":\"Toán lớp 8\",\"grade\":\"Lớp 8\",\"sessionsCount\":2,\"sessionFee\":220000,\"totalAmount\":440000,\"scheduleSummary\":\"Thứ 3 & Thứ 5 (18:30 - 20:00)\",\"status\":\"pending\"},\"createdAt\":\"2026-10-04T15:10:00+07:00\"}],\"safetyLogs\":[{\"id\":\"safe-001\",\"lessonId\":\"lesson-can-1\",\"tutorId\":\"demo-tutor\",\"action\":\"checkin\",\"timestamp\":\"2026-10-01T18:25:00+07:00\",\"location\":\"123 Điện Biên Phủ, P.15, Bình Thạnh\",\"note\":\"Gia sư đã check-in an toàn tại điểm dạy nhà phụ huynh\"}],\"twoWayReviews\":[{\"id\":\"tw-rev-001\",\"lessonId\":\"lesson-can-1\",\"tutorId\":\"demo-tutor\",\"learnerId\":\"demo-learner\",\"reviewerRole\":\"tutor\",\"studentAttitudeRating\":5,\"punctualityRating\":5,\"comment\":\"Bé An rất lễ phép, tập trung nghe giảng và làm bài tập đầy đủ. Phụ huynh chuẩn bị góc học tập rất yên tĩnh.\",\"createdAt\":\"2026-10-01T20:05:00+07:00\"}],\"payoutRequests\":[{\"id\":\"payout-001\",\"tutorId\":\"demo-tutor\",\"tutorName\":\"Trần Gia Bảo\",\"bankName\":\"Vietcombank\",\"accountNumber\":\"1012345678\",\"accountHolder\":\"TRAN GIA BAO\",\"amount\":500000,\"status\":\"pending\",\"requestedAt\":\"2026-10-04T16:00:00+07:00\",\"processedAt\":null,\"adminNote\":\"\"}],\"appliedDemoCleanups\":[\"2026-10-04-thursday-math-friday-availability\"]},\"key\":\"tnm.demo.domain.v1\",\"options\":{}})"},"stepId":"pw:api@30"}
