{"type":"before","callId":"call@62","startTime":124290.413,"class":"Page","method":"addInitScript","params":{"source":"(({\n    seed,\n    key: domainKey,\n    options\n  }) => {\n    if (sessionStorage.getItem('tnm.e2e.initialized')) return;\n    for (const key of Object.keys(localStorage)) {\n      if (key.startsWith('tnm.') || key === 'tutornearme.demo-auth.v1') localStorage.removeItem(key);\n    }\n    sessionStorage.removeItem('tutornearme.demo-auth.v1');\n    localStorage.setItem(domainKey, JSON.stringify(seed));\n    if (options.user) localStorage.setItem('tutornearme.demo-auth.v1', JSON.stringify({\n      user: options.user,\n      accounts: []\n    }));\n    if (options.legacySaved) localStorage.setItem('tnm.savedTutors', JSON.stringify(options.legacySaved));\n    sessionStorage.setItem('tnm.e2e.initialized', 'true');\n  })({\"seed\":{\"version\":1,\"profiles\":[{\"id\":\"mai-anh\",\"moderationStatus\":\"approved\",\"name\":\"Nguyễn Mai Anh\",\"initials\":\"MA\",\"avatarTone\":\"blue\",\"schedule\":[{\"days\":[0,2,4],\"start\":\"17:00\",\"end\":\"21:00\"},{\"days\":[5,6],\"start\":\"09:00\",\"end\":\"12:00\"}],\"subjects\":[\"Toán\",\"Vật lý\"],\"location\":\"Bình Thạnh\",\"availability\":[\"Buổi tối\",\"Buổi sáng\",\"Cuối tuần\"],\"price\":180000,\"rating\":4.9,\"reviews\":48,\"experience\":\"3 năm kinh nghiệm\",\"university\":\"ĐH Khoa học Tự nhiên\",\"featured\":true,\"verified\":true,\"image\":\"https://images.unsplash.com/photo-1551836022-d5d88e9218df?auto=format&fit=crop&w=800&q=82\",\"intro\":\"Giúp học sinh xây nền tảng vững chắc qua cách giải thích gần gũi và lộ trình học rõ ràng.\",\"levels\":[\"THCS\",\"THPT\"],\"approach\":\"Bắt đầu bằng việc kiểm tra nền tảng, chia nhỏ các dạng bài và luyện tập theo mức độ. Sau mỗi buổi, học viên nhận phần tổng kết và bài tập phù hợp với mục tiêu đang học.\",\"areas\":[\"Bình Thạnh\",\"Phú Nhuận\"],\"formats\":[\"Tại nhà\",\"Online\"],\"legacyLevels\":[\"THCS\",\"THPT\",\"Ôn thi vào 10\"],\"sessionMinutes\":90,\"legacyDuration\":90},{\"id\":\"quoc-bao\",\"moderationStatus\":\"approved\",\"accountId\":\"demo-tutor\",\"name\":\"Trần Gia Bảo\",\"initials\":\"GB\",\"avatarTone\":\"coral\",\"schedule\":[{\"days\":[1,3,4],\"start\":\"18:00\",\"end\":\"21:00\"},{\"days\":[5],\"start\":\"09:00\",\"end\":\"12:00\"}],\"subjects\":[\"Tiếng Anh\",\"IELTS\"],\"location\":\"Thủ Đức\",\"availability\":[\"Buổi tối\",\"Buổi sáng\",\"Cuối tuần\"],\"price\":220000,\"rating\":4.9,\"reviews\":36,\"experience\":\"4 năm kinh nghiệm\",\"university\":\"ĐH Ngoại thương\",\"featured\":false,\"verified\":true,\"image\":\"https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=600&q=82\",\"intro\":\"Tập trung phản xạ giao tiếp và phương pháp tự học để học viên tiến bộ bền vững.\",\"levels\":[\"THCS\",\"THPT\"],\"approach\":\"Kết hợp luyện nghe, giao tiếp và sửa bài trực tiếp. Xây dựng thói quen tự học với bài tập ngắn, theo dõi những lỗi thường gặp và phản hồi sau từng buổi.\",\"areas\":[\"Thủ Đức\",\"Bình Thạnh\"],\"formats\":[\"Tại nhà\",\"Online\"],\"legacyLevels\":[\"THCS\",\"THPT\",\"IELTS nền tảng\"],\"sessionMinutes\":45,\"legacyDuration\":90},{\"id\":\"ha-linh\",\"moderationStatus\":\"approved\",\"name\":\"Phạm Hà Linh\",\"initials\":\"HL\",\"avatarTone\":\"yellow\",\"schedule\":[{\"days\":[0,2,4],\"start\":\"13:00\",\"end\":\"17:00\"},{\"days\":[5,6],\"start\":\"09:00\",\"end\":\"12:00\"}],\"subjects\":[\"Ngữ văn\",\"Tiếng Anh\"],\"location\":\"Quận 3\",\"availability\":[\"Buổi chiều\",\"Buổi sáng\",\"Cuối tuần\"],\"price\":160000,\"rating\":4.8,\"reviews\":29,\"experience\":\"2 năm kinh nghiệm\",\"university\":\"ĐH Sư phạm TP.HCM\",\"featured\":false,\"verified\":true,\"image\":\"https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=600&q=82\",\"intro\":\"Biến bài học thành cuộc trò chuyện dễ hiểu, khuyến khích học viên đặt câu hỏi.\",\"levels\":[\"THCS\",\"THPT\"],\"approach\":\"Hướng dẫn đọc hiểu, lập dàn ý và thực hành diễn đạt qua từng bài. Với ngoại ngữ, ưu tiên củng cố kiến thức trên lớp và luyện tập theo tình huống gần gũi.\",\"areas\":[\"Quận 3\",\"Phú Nhuận\"],\"formats\":[\"Tại nhà\",\"Online\"],\"legacyLevels\":[\"THCS\",\"THPT\"],\"sessionMinutes\":90,\"legacyDuration\":90},{\"id\":\"duc-minh\",\"moderationStatus\":\"approved\",\"name\":\"Lê Đức Minh\",\"initials\":\"ĐM\",\"avatarTone\":\"cyan\",\"schedule\":[{\"days\":[1,3],\"start\":\"13:00\",\"end\":\"17:00\"},{\"days\":[0,2,4],\"start\":\"17:00\",\"end\":\"21:00\"}],\"subjects\":[\"Toán\",\"Hóa học\"],\"location\":\"Phú Nhuận\",\"availability\":[\"Buổi chiều\",\"Buổi tối\"],\"price\":170000,\"rating\":4.8,\"reviews\":31,\"experience\":\"3 năm kinh nghiệm\",\"university\":\"ĐH Bách khoa TP.HCM\",\"featured\":false,\"verified\":true,\"image\":\"https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&w=600&q=82\",\"intro\":\"Hướng dẫn từng bước và luyện tập theo mức độ, phù hợp học sinh cần củng cố kiến thức.\",\"levels\":[\"THCS\",\"THPT\"],\"approach\":\"Giải thích nguyên lý trước khi áp dụng công thức. Luyện bài từ cơ bản đến nâng cao, giúp học viên hiểu cách làm và tự kiểm tra kết quả.\",\"areas\":[\"Phú Nhuận\",\"Bình Thạnh\"],\"formats\":[\"Tại nhà\",\"Online\"],\"legacyLevels\":[\"THCS\",\"THPT\",\"Ôn tập kiểm tra\"],\"sessionMinutes\":45,\"legacyDuration\":120},{\"id\":\"thu-trang\",\"moderationStatus\":\"approved\",\"name\":\"Võ Thu Trang\",\"initials\":\"TT\",\"avatarTone\":\"violet\",\"schedule\":[{\"days\":[0,2,4,5,6],\"start\":\"08:00\",\"end\":\"12:00\"}],\"subjects\":[\"Tiếng Anh\",\"Ngữ văn\"],\"location\":\"Bình Thạnh\",\"availability\":[\"Buổi sáng\",\"Cuối tuần\"],\"price\":190000,\"rating\":4.7,\"reviews\":22,\"experience\":\"2 năm kinh nghiệm\",\"university\":\"ĐH Sư phạm TP.HCM\",\"featured\":false,\"verified\":true,\"image\":\"https://images.unsplash.com/photo-1531123897727-8f129e1688ce?auto=format&fit=crop&w=600&q=82\",\"intro\":\"Lớp học cởi mở, chú trọng thực hành và ghi nhận tiến bộ qua từng buổi.\",\"levels\":[\"Tiểu Học\",\"THCS\"],\"approach\":\"Tạo không gian học cởi mở với hoạt động thực hành và phản hồi cụ thể. Mục tiêu được chia thành các bước nhỏ để học viên dễ theo dõi tiến bộ.\",\"areas\":[\"Bình Thạnh\"],\"formats\":[\"Tại nhà\",\"Online\"],\"legacyLevels\":[\"Tiểu học\",\"THCS\"],\"sessionMinutes\":45,\"legacyDuration\":60},{\"id\":\"gia-huy\",\"moderationStatus\":\"approved\",\"name\":\"Đặng Gia Huy\",\"initials\":\"GH\",\"avatarTone\":\"slate\",\"schedule\":[{\"days\":[1,3,4],\"start\":\"19:00\",\"end\":\"21:00\"}],\"subjects\":[\"Vật lý\",\"Toán\"],\"location\":\"Thủ Đức\",\"availability\":[\"Buổi tối\"],\"price\":150000,\"rating\":4.7,\"reviews\":18,\"experience\":\"2 năm kinh nghiệm\",\"university\":\"ĐH Khoa học Tự nhiên\",\"featured\":false,\"verified\":false,\"image\":\"https://images.unsplash.com/photo-1504257432389-52343af06ae3?auto=format&fit=crop&w=600&q=82\",\"intro\":\"Liên hệ kiến thức với tình huống thực tế để các công thức trở nên dễ nhớ hơn.\",\"levels\":[\"THCS\",\"THPT\"],\"approach\":\"Liên hệ bài học với tình huống thực tế, sử dụng ví dụ trực quan và luyện tập từng bước. Ưu tiên củng cố nền tảng trước khi học dạng bài khó hơn.\",\"areas\":[\"Thủ Đức\"],\"formats\":[\"Tại nhà\",\"Online\"],\"legacyLevels\":[\"THCS\",\"THPT\"],\"sessionMinutes\":90,\"legacyDuration\":90},{\"id\":\"thao-vy\",\"moderationStatus\":\"pending\",\"status\":\"pending\",\"name\":\"Lê Thảo Vy\",\"initials\":\"TV\",\"avatarTone\":\"violet\",\"schedule\":[{\"days\":[1,3,5],\"start\":\"18:00\",\"end\":\"21:00\"}],\"subjects\":[\"Tiếng Anh\"],\"location\":\"Quận 1\",\"areas\":[\"Quận 1\",\"Quận 3\"],\"availability\":[\"Buổi tối\"],\"price\":160000,\"rating\":5,\"reviews\":0,\"experience\":\"2 năm kinh nghiệm\",\"university\":\"ĐH Sư phạm TP.HCM\",\"school\":\"ĐH Sư phạm TP.HCM\",\"featured\":false,\"verified\":false,\"image\":\"https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=600&q=82\",\"intro\":\"Sinh viên năm cuối ĐH Sư phạm TP.HCM, chứng chỉ IELTS 8.0, 2 năm kinh nghiệm luyện đề và giao tiếp.\",\"levels\":[\"THPT\",\"Luyện thi đại học\",\"IELTS\"],\"approach\":\"Tập trung phản xạ giao tiếp và phương pháp xử lý bẫy trong đề thi thực tế.\",\"formats\":[\"Online\",\"Tại nhà\"],\"sessionMinutes\":90,\"submittedAt\":\"2026-10-04T09:20:00+07:00\",\"submitted\":\"Hôm nay, 09:20\",\"documents\":[{\"id\":\"doc-1\",\"title\":\"Thẻ sinh viên\",\"type\":\"student_card\",\"file\":\"the_sv_hcmue.jpg\",\"issuedBy\":\"Trường ĐH Sư phạm TP.HCM\",\"number\":\"46.01.701.082\",\"fileType\":\"JPG\",\"fileSize\":\"1.8 MB\",\"uploadedAt\":\"2026-10-04T09:20:00+07:00\",\"status\":\"verified\",\"verified\":true},{\"id\":\"doc-2\",\"title\":\"CCCD\",\"type\":\"id_card\",\"file\":\"cccd_lethaovy.pdf\",\"issuedBy\":\"Cục CSQLHC về TTXH\",\"number\":\"079198001234\",\"fileType\":\"PDF\",\"fileSize\":\"2.4 MB\",\"uploadedAt\":\"2026-10-04T09:20:00+07:00\",\"status\":\"verified\",\"verified\":true}],\"verificationDocuments\":[{\"id\":\"doc-1\",\"title\":\"Thẻ sinh viên\",\"type\":\"student_card\",\"file\":\"the_sv_hcmue.jpg\",\"issuedBy\":\"Trường ĐH Sư phạm TP.HCM\",\"number\":\"46.01.701.082\",\"fileType\":\"JPG\",\"fileSize\":\"1.8 MB\",\"uploadedAt\":\"2026-10-04T09:20:00+07:00\",\"status\":\"verified\",\"verified\":true},{\"id\":\"doc-2\",\"title\":\"CCCD\",\"type\":\"id_card\",\"file\":\"cccd_lethaovy.pdf\",\"issuedBy\":\"Cục CSQLHC về TTXH\",\"number\":\"079198001234\",\"fileType\":\"PDF\",\"fileSize\":\"2.4 MB\",\"uploadedAt\":\"2026-10-04T09:20:00+07:00\",\"status\":\"verified\",\"verified\":true}],\"verificationDocs\":[{\"id\":\"doc-1\",\"title\":\"Thẻ sinh viên\",\"type\":\"student_card\",\"file\":\"the_sv_hcmue.jpg\",\"issuedBy\":\"Trường ĐH Sư phạm TP.HCM\",\"number\":\"46.01.701.082\",\"fileType\":\"JPG\",\"fileSize\":\"1.8 MB\",\"uploadedAt\":\"2026-10-04T09:20:00+07:00\",\"status\":\"verified\",\"verified\":true},{\"id\":\"doc-2\",\"title\":\"CCCD\",\"type\":\"id_card\",\"fil