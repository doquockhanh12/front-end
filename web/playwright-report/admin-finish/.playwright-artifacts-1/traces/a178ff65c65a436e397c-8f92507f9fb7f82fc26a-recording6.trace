_primary { min-width: 0; }\n.tutor-dashboard__layout .tutor-main__columns { gap: 20px; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }\n.tutor-dashboard__layout .tutor-section { padding: 18px; border: var(--border-default); border-radius: var(--radius-lg); background: var(--color-surface); }\n.tutor-dashboard__layout .tutor-section__heading { align-items: center; min-height: 0; }\n.tutor-dashboard__layout .tutor-section__heading h2 { font-size: 1.1rem; }\n.tutor-dashboard__layout .tutor-request__details, .tutor-dashboard__layout .tutor-request__note, .tutor-dashboard__layout .tutor-request__actions { margin-left: 0; }\n.tutor-dashboard__layout .tutor-request__header { flex-wrap: wrap; }\n.tutor-dashboard__layout .tutor-request__header > .badge { margin-left: 45px; }\n.tutor-dashboard__layout .tutor-request__header h3 { white-space: normal; overflow: visible; }\n.tutor-dashboard__layout .tutor-request__actions { flex-wrap: wrap; }\n.tutor-dashboard__layout .tutor-lesson { flex-wrap: wrap; gap: 8px; }\n.tutor-dashboard__layout .tutor-lesson__when { width: 100%; display: flex; gap: 8px; }\n.tutor-dashboard__layout .tutor-lesson__body { flex-basis: 100%; }\n.tutor-dashboard__layout .tutor-lesson .badge { margin-left: 0; }\n.tutor-dashboard__layout .tutor-combined-calendar > .tutor-section { padding: 16px 0 0; border: 0; border-top: var(--border-default); border-radius: 0; }\n.tutor-combined-calendar .eyebrow { display: none; }\n.tutor-combined-calendar .tutor-agenda .text-link { display: none; }\n.tutor-combined-calendar .tutor-schedule__grid { display: block; }\n.tutor-combined-calendar .tutor-schedule__day { display: flex; min-height: 0; border-right: 0; border-bottom: var(--border-default); }\n.tutor-combined-calendar .tutor-schedule__day:last-child { border-bottom: 0; }\n.tutor-combined-calendar .tutor-schedule__date { width: 46px; flex: none; border-bottom: 0; border-right: var(--border-default); }\n.tutor-combined-calendar .tutor-schedule__events { display