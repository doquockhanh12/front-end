ound: var(--color-surface); }\n.tutor-sidebar__brand { display: flex; align-items: center; justify-content: space-between; min-height: 68px; padding: 0 18px; border-bottom: var(--border-default); }\n.tutor-sidebar__close { display: none; }\n.tutor-sidebar__workspace { display: grid; gap: 3px; padding: 23px 20px 13px; }\n.tutor-sidebar__workspace strong { font-size: .95rem; }\n.tutor-sidebar__workspace > span:last-child { color: var(--color-success); font-size: .76rem; }\n.tutor-sidebar__nav { display: grid; align-content: start; gap: 3px; padding: 0 10px 20px; }\n.tutor-sidebar__footer { display: flex; align-items: center; gap: 10px; margin-top: auto; padding: 17px 18px; border-top: var(--border-default); }\n.tutor-sidebar__footer div { display: grid; line-height: 1.2; }\n.tutor-sidebar__footer strong { font-size: .82rem; }\n.tutor-sidebar__footer span { margin-top: 4px; color: var(--color-text-muted); font-size: .73rem; }\n.tutor-topbar .workspace-topbar__user { display: block; margin-left: 0; }\n.tutor-topbar .role-switcher { margin-left: 0; }\n\n.tutor-main { width: min(100%, 1540px); margin-inline: auto; padding: 28px var(--page-padding) 60px; }\n.tutor-page-head { display: flex; align-items: end; justify-content: space-between; gap: 22px; margin-bottom: 26px; }\n.tutor-page-head h1 { margin: 5px 0 3px; font-size: clamp(1.7rem, 2.2vw, 2rem); line-height: 1.25; letter-spacing: -.035em; }\n.tutor-page-head p { margin: 0; color: var(--color-text-secondary); font-size: .93rem; }\n.tutor-summary { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-bottom: 32px; border-block: var(--border-default); background: #ffffffb5; }\n.tutor-summary .stat-item:first-child { padding-left: 0; }\n.tutor-summary .stat-item:last-child { padding-right: 0; }\n.tutor-main__columns { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); gap: 28px; align-items: start; }\n.tutor-main__bottom { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(280px, .55fr); gap: 28px; margin-top: 34px; align-items: start; }\n.tutor-section { min-width: 0; }\n.tutor-section__heading { display: flex; align-items: end; justify-content: space-between; gap: 12px; min-height: 50px; margin-bottom: 14px; }\n.tutor-section__heading h2 { margin: 4px 0 0; font-size: 1.26rem; line-height: 1.2; letter-spacing: -.025em; }\n.tutor-section__heading .text-link { padding-bottom: 2px; white-space: nowrap; font-size: .83rem; }\n.tutor-section__count, .tutor-section__hint { color: var(--color-text-muted); font-size: .82rem; white-space: nowrap; }\n.tutor-agenda__list, .tutor-request-list, .tutor-availability__list { border-top: var(--border-default); }\n.tutor-lesson { display: flex; align-items: center; gap: 18px; min-height: 92px; padding: 14px 0; border-bottom: var(--border-default); }\n.tutor-lesson__when { display: grid; gap: 2px; flex: none; width: 112px; }\n.tutor-lesson__when strong { font-size: .9rem; }\n.tutor-lesson__when span { color: var(--color-text-secondary); font-size: .83rem; font-variant-numeric: tabular-nums; }\n.tutor-lesson__body { flex: 1; min-width: 0; }\n.tutor-lesson__body h3 { margin: 0 0 3px; font-size: 1rem; }\n.tutor-lesson__body p { margin: 0; color: var(--color-text-secondary); font-size: .82rem; }\n.tutor-lesson .badge { flex: none; }\n.tutor-request { padding: 15px 0 16px; border-bottom: var(--border-default); }\n.tutor-request__header { display: flex; align-items: center; gap: 9px; }\n.tutor-request__header > div { display: grid; flex: 1; gap: 1px; min-width: 0; }\n.tutor-request__header h3 { overflow: hidden; margin: 0; font-size: .94rem; text-overflow: ellipsis; white-space: nowrap; }\n.tutor-request__header > div > span { color: var(--color-text-muted); font-size: .75rem; }\n.tutor-request__details { display: flex; flex-wrap: wrap; gap: 3px 9px; margin: 10px 0 3px 45px; font-size: .83rem; }\n.tutor-request__details span { color: var(--color-text-secondary); }\n.tutor-request__note { margin: 0 0 11px 45px; color: var(--color-text-secondary); font-size: .82rem; }\n.tutor-request__actions { display: flex; gap: 7px; margin-left: 45px; }\n\n.tutor-schedule__grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); border: var(--border-default); border-radius: var(--radius-md); background: var(--color-surface); }\n.tutor-schedule__day { min-width: 0; min-height: 155px; border-right: var(--border-default); }\n.tutor-schedule__day:last-child { border-right: 0; }\n.tutor-schedule__date { display: grid; justify-items: center; gap: 2px; padding: 10px 4px; border-bottom: var(--border-default); color: var(--color-text-secondary); font-size: .75rem; }\n.tutor-schedule__date strong { display: grid; place-items: center; width: 27px; height: 27px; color: var(--color-ink); font-size: .86rem; }\n.tutor-schedule__day.is-today .tutor-schedule__date strong { border-radius: 50%; background: var(--color-brand); color: var(--color-surface); }\n.tutor-schedule__events { display: grid; align-content: start; gap: 6px; padding: 7px 5px; }\n.tutor-schedule__event { display: grid; gap: 2px; min-width: 0; padding: 7px 6px; border-left: 2px solid var(--color-brand); border-radius: var(--radius-sm); background: var(--color-brand-light); }\n.tutor-schedule__event--coral { border-color: var(--brand-accent-red); background: #ffeaec; }\n.tutor-schedule__event--yellow { border-color: var(--status-warning); background: var(--status-warning-bg); }\n.tutor-schedule__event span { font-size: .76rem; font-variant-numeric: tabular-nums; }\n.tutor-schedule__event strong { overflow-wrap: anywhere; font-size: .81rem; line-height: 1.2; }\n.tutor-schedule__empty { color: var(--color-text-muted); font-size: .7rem; text-align: center; }\n.tutor-schedule__caption { margin: 8px 0 0; color: var(--color-text-muted); font-size: .73rem; }\n.tutor-availability__slot { display: flex; align-items: center; gap: 10px; width: 100%; min-height: 62px; padding: 9px 0; border-bottom: var(--border-default); backg