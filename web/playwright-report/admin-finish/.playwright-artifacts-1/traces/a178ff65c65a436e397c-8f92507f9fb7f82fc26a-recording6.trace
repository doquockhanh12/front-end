ius: 50%; background: var(--color-brand); color: white; font-weight: 900; }\n.tutor-class-pin.is-selected { background: var(--brand-accent-red); outline: 3px solid var(--brand-accent-yellow); }\n.tutor-class-map-layout > .tutor-section { padding: 20px; border: var(--border-default); border-radius: var(--radius-lg); background: var(--color-surface); }\n.tutor-class-map-layout h2 { margin-top: 0; font-size: 1.2rem; }\n.tutor-class-list { display: grid; gap: 10px; }\n.tutor-class-list button { display: grid; gap: 5px; width: 100%; min-height: 64px; padding: 12px; border: var(--border-default); border-radius: var(--radius-md); background: white; text-align: left; }\n.tutor-class-list button.is-selected { border-color: var(--color-brand); background: var(--color-brand-light); }\n.tutor-class-list span { color: var(--color-text-secondary); font-size: .86rem; }\n.tutor-class-detail { margin-top: 20px; border-top: var(--border-default); }\n@media (max-width: 1279px) {\n  .tutor-dashboard__layout { grid-template-columns: 1fr; }\n  .tutor-dashboard__support { grid-template-columns: repeat(3, minmax(0, 1fr)); }\n  .tutor-profile-facts, .tutor-quick-links { grid-template-columns: 1fr; }\n  .tutor-income-list > div { grid-template-columns: 1fr auto; }\n  .tutor-income-list > div > span:first-child { grid-column: 1 / -1; }\n}\n@media (max-width: 767px) {\n  .tutor-header__nav { gap: 8px 16px; flex-wrap: wrap; }\n  .tutor-header__nav a { font-size: .82rem; gap: 5px; }\n  .tutor-topbar { flex-wrap: wrap; }\n  .tutor-header__account { font-size: .82rem; }\n  .tutor-header__account > span:last-child { max-width: 90px; }\n  .tutor-dashboard__layout .tutor-main__columns, .tutor-dashboard__support, .tutor-class-map-layout { grid-template-columns: 1fr; }\n  .tutor-profile-facts, .tutor-quick-links { grid-template-columns: 1fr 1fr; }\n}\n\n@media (max-width: 1279px) {\n  .tutor-main__bottom { grid-template-columns: minmax(0, 1fr); }\n  .tutor-schedule__day { min-height: 135px; }\n}\n@media (max-width: 1023px) {\n  .tutor-sidebar { position: fixed; z-index: 31; left: 0; top: 0; width: var(--sidebar-tutor); transform: translateX(-100%); transition: transform var(--motion-fast); }\n  .tutor-sidebar.is-open { transform: translateX(0); }\n  .tutor-sidebar__close { display: inline-grid; }\n  .tutor-main__columns { gap: 20px; }\n}\n@media (max-width: 767px) {\n  .tutor-topbar .workspace-topbar__user { display: none; }\n  .tutor-main { padding-top: 23px; }\n  .tutor-page-head { display: block; margin-bottom: 18px; }\n  .tutor-page-head .button { margin-top: 17px; }\n  .tutor-summary { grid-template-columns: repeat(3, minmax(0, 1fr)); margin-bottom: 23px; }\n  .tutor-summary .stat-item { padding: 12px 9px; }\n  .tutor-summary .stat-item:first-child { padding-left: 0; }\n  .tutor-summary .stat-item:last-child { padding-right: 0; }\n  .tutor-summary .stat-item__top { font-size: .7rem; line-height: 1.2; }\n  .tutor-summary .stat-item__note { display: none; }\n  .tutor-main__columns, .tutor-main__bottom { display: grid; grid-template-columns: 1fr; gap: 26px; }\n  .tutor-lesson { flex-wrap: wrap; gap: 8px 12px; }\n  .tutor-lesson__when { width: 85px; }\n  .tutor-lesson__body { flex-basis: calc(100% - 100px); }\n  .tutor-lesson .badge { margin-left: 97px; }\n  .tutor-schedule__grid { display: block; }\n  .tutor-schedule__day { display: flex; min-height: 0; border-right: 0; border-bottom: var(--border-default); }\n  .tutor-schedule__day:last-child { border-bottom: 0; }\n  .tutor-schedule__date { width: 65px; flex: none; align-content: center; border-right: var(--border-default); border-bottom: 0; }\n  .tutor-schedule__events { display: flex; align-items: center; flex-wrap: wrap; flex: 1; min-height: 61px; padding: 8px; }\n  .tutor-schedule__event { min-width: 130px; }\n  .tutor-schedule__event strong { font-size: .78rem; }\n  .tutor-schedule__empty { padding: 6px; }\n}\n"],["STYLE",{},".admin-workspace { grid-template-columns: var(--sidebar-admin) minmax(0, 1fr); background: #f4f7fc; font-size: .9rem; }\n.admin-sidebar { position: sticky; top: 0; display: flex; flex-direction: column; height: 100vh; overflow-y: auto; border-right: var(--border-default); background: var(--color-surface); }\n.admin-sidebar__brand { display: flex; align-items: center; justify-content: space-between; min-height: 64px; padding: 0 16px; border-bottom: var(--border-default); }\n.admin-sidebar__close { display: none; }\n.admin-sidebar__label { padding: 24px 18px 10px; color: var(--color-text-muted); font-size: .67rem; font-weight: 700; letter-spacing: .13em; }\n.admin-sidebar__nav { display: grid; align-content: start; gap: 2px; padding: 0 8px; }\n.admin-sidebar .sidebar-item { min-height: 39px; padding: 7px 10px; border-radius: var(--radius-sm); font-size: .86rem; }\n.admin-sidebar__footer { display: grid; gap: 5px; margin-top: auto; padding: 16px 18px; border-top: var(--border-default); }\n.admin-sidebar__environment { display: flex; align-items: center; gap: 8px; font-size: .79rem; font-weight: 700; }\n.admin-sidebar__environment > span { width: 7px; height: 7px; border-radius: 50%; background: var(--color-success); }\n.admin-sidebar__footer small { color: var(--color-text-muted); font-size: .72rem; }\n.admin-topbar { min-height: 64px; gap: 16px; }\n.admin-topbar__actions { display: flex; align-items: center; gap: 12px; margin-left: auto; }\n.admin-topbar__user { display: flex; align-items: center; gap: 8px; flex: none; font-size: .8rem; font-weight: 700; }\n.admin-header__logout { flex: none; color: var(--brand-accent-red); }\n.admin-header__logout:hover { color: var(--brand-accent-red); background: #ffeaec; }\n\n.admin-main { width: min(100%, 1700px); margin-inline: auto; padding: 24px var(--page-padding) 48px; }\n.admin-page-head { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 19px; }\n.admin-page-head h1 { margin: 3px 0 2px; font-size: 1.63rem; line-height: 1.25; letter-spacing: -.03em; }\n.admin-page-head p { margin: 0; color: var(--color-text-secondary); font-size: .88rem; }\n.admin-page-head__date { color: var(--color-text-muted); font-size: .82rem; white-space: nowrap; text-transform: capitalize; }\n.admin-summary { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-bottom: 24px; border: var(--border-default); border-radius: var(--radius-sm); background: var(--color-surface); }\n@media (min-width: 1400px) {\n  .admin-summary { grid-template-columns: repeat(6, minmax(0, 1fr)); }\n}\n@media (max-width: 900px) {\n  .admin-summary { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n}\n@media (max-width: 540px) {\n  .admin-summary { grid-template-columns: 1fr; }\n}\n\n@keyframes admin-pulse-red {\n  0% { box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.7); border-color: #dc2626; }\n  70% { box-shadow: 0 0 0 10px rgba(220, 38, 38, 0); border-color: #ef4444; }\n  100% { box-shadow: 0 0 0 0 rgba(220, 38, 38, 0); border-color: #dc2626; }\n}\n\n.admin-sos-banner {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  flex-wrap: wrap;\n  margin-bottom: 20px;\n  padding: 14px 20px;\n  border-radius: var(--radius-sm, 8px);\n  background: #fef2f2;\n  border: 2px solid #dc2626;\n  color: #991b1b;\n  animation: admin-pulse-red 2s infinite;\n}\n\n.admin-sos-banner__content {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  flex-wrap: wrap;\n}\n\n.admin-sos-banner__badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 4px 10px;\n  border-radius: 9999px;\n  background: #dc2626;\n  color: #ffffff;\n  font-size: 0.75rem;\n  font-weight: 800;\n  letter-spacing: 0.05em;\n  text-transform: uppercase;\n}\n\n.admin-sos-banner__details {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  font-size: 0.85rem;\n  color: #7f1d1d;\n  flex-wrap: wrap;\n}\n\n.admin-sos-banner__details strong {\n  color: #991b1b;\n}\n\n.admin-sos-banner__note {\n  margin: 0;\n  width: 100%;\n  font-size: 0.82rem;\n  color: #b91c1c;\n}\n\n.admin-sos-banner__actions {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.admin-sos-banner__link {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 8px 14px;\n  border-radius: 6px;\n  background: #dc2626;\n  color: #ffffff !important;\n  font-size: 0.82rem;\n  font-weight: 700;\n  text-decoration: none;\n  transition: background 0.15s ease;\n}\n\n.admin-sos-banner__link:hover {\n  background: #b91c1c;\n}\n\n.admin-summary .stat-item { padding: 14px 16px; }\n.admin-summary .stat-item__top { font-size: .79rem; }\n.admin-summary .stat-item > strong { font-size: 1.65rem; margin-block: 4px; }\n.admin-summary .stat-item__note { font-size: .74rem; }\n.admin-grid { display: grid; grid-template-columns: minmax(0, 1.36fr) minmax(330px, .84fr); gap: 20px; align-items: start; }\n.admin-section { min-width: 0; border: var(--border-default); border-radius: var(--radius-sm); background: var(--color-surface); }\n.admin-section__heading { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 14px; min-height: 70px; padding: 13px 16px 12px; }\n.admin-section__heading h2 { margin: 3px 0 0; font-size: 1.08rem; line-height: 1.2; }\n.admin-section__count { color: var(--color-text-muted); font-size: .8rem; white-space: nowrap; }\n.admin-section__filter { display: flex; align-items: center; gap: 7px; padding: 8px 16px; border-block: var(--border-default); color: var(--color-text-secondary); font-size: .8rem; }\n.admin-section__filter select { height: 32px; padding: 0 7px; border-radius: var(--radius-sm); font-size: .8rem; }\n.admin-table-scroll { overflow-x: auto; scrollbar-color: var(--color-border-strong) transparent; }\n.admin-table { width: 100%; min-width: 620px; table-layout: fixed; font-size: .875rem; }\n.admin-table th, .admin-table td { padding: 10px 11px; border-bottom: var(--border-default); text-align: left; vertical-align: middle; }\n.admin-table th { position: sticky; top: 0; z-index: 2; background: #eef3fb; color: var(--color-text-secondary); font-size: .875rem; font-weight: 700; white-space: nowrap; }\n.admin-table td { height: 56px; color: var(--color-ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.admin-table tbody tr:last-child td { border-bottom: 0; }\n.admin-table--approvals { min-width: 680px; }\n.admin-table--approvals th:nth-child(1) { width: 28%; }\n.admin-table--approvals th:nth-child(2) { width: 20%; }\n.admin-table--approvals th:nth-child(3) { width: 18%; }\n.admin-table--approvals th:nth-child(4) { width: 18%; }\n.admin-table--approvals th:nth-child(5) { width: 16%; }\n.admin-person { display: flex; align-items: center; gap: 8px; min-width: 0; }\n.admin-person > div { display: grid; min-width: 0; line-height: 1.2; }\n.admin-person strong, .admin-person small { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.admin-person strong { font-size: .875rem; }\n.admin-person small { margin-top: 3px; color: var(--color-text-muted); font-size: .75rem; }\n.admin-row-actions { display: flex; align-items: center; gap: 4px; flex-wrap: wrap; }\n.admin-row-actions button { flex: none; display: grid; place-items: center; width: 31px; height: 31px; border: var(--border-default); border-radius: var(--radius-sm); background: var(--color-surface); color: var(--color-brand); }\n.admin-row-actions button:last-child { color: var(--color-danger); }\n.admin-row-actions button:hover { background: var(--color-brand-light); }\n.admin-row-actions button:last-child:hover { background: var(--color-danger-bg); }\n.admin-row-actions__done { color: var(--color-text-muted); font-size: .77rem; }\n.admin-table__empty { padding-block: 30px !important; color: var(--color-text-muted) !important; text-align: center !important; white-space: normal !important; }\n.admin-section__footnote { margin: 0; padding: 9px 16px; border-top: var(--border-default); color: var(--color-text-muted); font-size: .73rem; }\n\n.admin-live__list, .admin-reviews__list, .admin-issues__list { border-top: var(--border-default); }\n.admin-live__row { display: flex; align-items: center; gap: 12px; min-height: 70px; padding: 10px 16px; border-bottom: var(--border-default); }\n.admin-live__row:last-child, .admin-review:last-child, .admin-issue:last-child { border-bottom: 0; }\n.admin-live__time { display: grid; gap: 3px; flex: none; width: 60px; font-variant-numeric: tabular-nums; }\n.admin-live__time strong { font-size: .84rem; }\n.admin-live__time span { color: var(--color-text-muted); font-size: .72rem; }\n.admin-live__body { display: grid; gap: 3px; flex: 1; min-width: 0; }\n.admin-live__body strong, .admin-live__body span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.admin-live__body strong { font-size: .86rem; }\n.admin-live__body span { color: var(--color-text-secondary); font-size: .76rem; }\n.admin-live__row .badge { font-size: .69rem; }\n.admin-review { display: flex; align-items: center; gap: 15px; min-height: 76px; padding: 12px 16px; border-bottom: var(--border-default); }\n.admin-review__main { flex: 1; min-width: 0; max-width: 100%; }\n.admin-review__main > div { font-size: .85rem; }\n.admin-review__main > div span { color: var(--color-text-secondary); }\n.admin-review__main p { overflow: hidden; margin: 4px 0 0; color: var(--color-text-secondary); font-size: .82rem; text-overflow: ellipsis; white-space: nowrap; }\n.admin-review__actions { display: flex; flex: none; gap: 3px; }\n.admin-issue { display: flex; align-items: center; gap: 12px; min-height: 64px; padding: 10px 16px; border-bottom: var(--border-default); }\n.admin-issue__id { width: 65px; flex: none; color: var(--color-text-muted); font-size: .76rem; font-weight: 700; font-variant-numeric: tabular-nums; }\n.admin-issue > div { display: grid; flex: 1; gap: 2px; min-width: 0; }\n.admin-issue strong { overflow: hidden; font-size: .84rem; text-overflow: ellipsis; white-space: nowrap; }\n.admin-issue > div span { overflow: hidden; color: var(--color-text-secondary); font-size: .75rem; text-overflow: ellipsis; white-space: nowrap; }\n.admin-issue .badge { font-size: .69rem; }\n\n@media (max-width: 1279px) {\n  .admin-grid { grid-template-columns: minmax(0, 1fr) minmax(300px, .75fr); gap: 14px; }\n  .admin-topbar__user > span:last-child { display: none; }\n}\n@media (max-width: 1023px) {\n  .admin-sidebar { position: fixed; z-index: 31; left: 0; top: 0; width: var(--sidebar-admin); transform: translateX(-100%); transition: transform var(--motion-fast); }\n  .admin-sidebar.is-open { transform: translateX(0); }\n  .admin-sidebar__close { display: inline-grid; }\n  .admin-grid { grid-template-columns: minmax(0, 1fr); }\n}\n@media (max-width: 767px) {\n  .admin-topbar__user { display: none; }\n  .admin-main { padding-top: 20px; }\n  .admin-page-head { display: block; }\n  .admin-page-head h1 { font-size: 1.48rem; }\n  .admin-page-head__date { display: block; margin-top: 9px; }\n  .admin-summary { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n  .admin-summary .stat-item:nth-child(2) { border-right: 0; }\n  .admin-summary .stat-item:nth-child(-n+2) { border-bottom: var(--border-default); }\n  .admin-summary .stat-item { padding: 12px; }\n  .admin-summary .stat-item__top { font-size: .74rem; }\n  .admin-summary .stat-item__note { display: none; }\n  .admin-section__heading { min-height: 62px; padding-inline: 12px; }\n  .admin-section__filter { padding-inline: 12px; }\n  .admin-live__row, .admin-review, .admin-issue { padding-inline: 12px; }\n  .admin-row-actions button { width: 44px; height: 44px; }\n  .admin-live__row { flex-wrap: wrap; gap: 4px 8px; }\n  .admin-live__body { flex-basis: calc(100% - 68px); }\n  .admin-live__row .badge { margin-left: 68px; }\n  .admin-review { align-items: start; flex-direction: column; gap: 8px; }\n  .admin-issue { flex-wrap: wrap; }\n  .admin-issue .badge { margin-left: 77px; }\n}\n\n/* Admin Operational Pages - Filter bar, Tabs & Record counter */\n.admin-filter-bar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  margin-bottom: 12px;\n  flex-wrap: wrap;\n}\n\n.admin-tabs {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  flex-wrap: wrap;\n}\n\n.admin-tab {\n  padding: 6px 14px;\n  border-radius: var(--radius-sm);\n  border: var(--border-default);\n  background: var(--color-surface);\n  color: var(--color-text-secondary);\n  font-size: 0.85rem;\n  font-weight: 700;\n  cursor: pointer;\n  transition: all var(--motion-fast);\n}\n\n.admin-tab:hover {\n  background: #f1f5f9;\n  color: var(--color-ink);\n}\n\n.admin-tab.is-active {\n  background: var(--color-brand);\n  color: #fff;\n  border-color: var(--color-brand);\n}\n\n.admin-filter-bar__search {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 0 12px;\n  height: 38px;\n  border: var(--border-default);\n  border-radius: var(--radius-sm);\n  background: var(--color-surface);\n  min-width: 280px;\n}\n\n.admin-filter-bar__search input {\n  border: 0;\n  outline: 0;\n  background: transparent;\n  width: 100%;\n  font-size: 0.85rem;\n  color: var(--color-ink);\n}\n\n.admin-record-counter {\n  margin-bottom: 14px;\n  font-size: 0.82rem;\n  color: var(--color-text-muted);\n  font-weight: 600;\n}\n\n.admin-table-section {\n  border: var(--border-default);\n  border-radius: var(--radius-sm);\n  background: var(--color-surface);\n  overflow: hidden;\n}\n\n.admin-table--tutors { min-width: 880px; }\n.admin-table--tutors th:nth-child(1) { width: 24%; }\n.admin-table--tutors th:nth-child(2) { width: 19%; }\n.admin-table--tutors th:nth-child(3) { width: 14%; }\n.admin-table--tutors th:nth-child(4) { width: 14%; }\n.admin-table--tutors th:nth-child(5) { width: 14%; }\n.admin-table--tutors th:nth-child(6) { width: 15%; }\n\n.admin-table--users { min-width: 960px; }\n.admin-table--users th:nth-child(1) { width: 20%; }\n.admin-table--users th:nth-child(2) { width: 23%; }\n.admin-table--users th:nth-child(3) { width: 13%; }\n.admin-table--users th:nth-child(4) { width: 11%; }\n.admin-table--users th:nth-child(5) { width: 11%; }\n.admin-table--users th:nth-child(6) { width: 13%; }\n.admin-table--users th:nth-child(7) { width: 9%; }\n\n.admin-table--reviews { min-width: 920px; }\n.admin-table--reviews th:nth-child(1) { width: 16%; }\n.admin-table--reviews th:nth-child(2) { width: 15%; }\n.admin-table--reviews th:nth-child(3) { width: 9%; }\n.admin-table--reviews th:nth-child(4) { width: 27%; }\n.admin-table--reviews th:nth-child(5) { width: 11%; }\n.admin-table--reviews th:nth-child(6) { width: 11%; }\n.admin-table--reviews th:nth-child(7) { width: 11%; }\n\n.admin-table--issues { min-width: 920px; }\n.admin-table--issues th:nth-child(1) { width: 12%; }\n.admin-table--issues th:nth-child(2) { width: 16%; }\n.admin-table--issues th:nth-child(3) { width: 16%; }\n.admin-table--issues th:nth-child(4) { width: 16%; }\n.admin-table--issues th:nth-child(5) { width: 13%; }\n.admin-table--issues th:nth-child(6) { width: 14%; }\n.admin-table--issues th:nth-child(7) { width: 13%; }\n\n.admin-cell-truncate {\n  display: block;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  min-width: 0;\n  max-width: 100%;\n}\n\n.admin-tags-cell {\n  font-size: 0.82rem;\n  color: var(--color-text-secondary);\n  line-height: 1.3;\n  display: block;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.admin-role-badge {\n  font-size: 0.8rem;\n  font-weight: 700;\n  color: var(--color-brand);\n  white-space: nowrap;\n}\n\n.admin-stars-cell {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n}\n\n.admin-stars-cell .star-filled {\n  color: #f59e0b;\n  fill: #f59e0b;\n}\n\n.admin-excerpt-cell {\n  display: -webkit-box;\n  -webkit-line-clamp: 2;\n  -webkit-box-orient: vertical;\n  overflow: hidden;\n  font-size: 0.82rem;\n  color: var(--color-text-secondary);\n  font-style: italic;\n  white-space: normal;\n}\n\n.admin-ticket-code {\n  font-family: monospace;\n  font-size: 0.82rem;\n  color: var(--color-brand);\n}\n\n.admin-category-tag {\n  display: inline-block;\n  padding: 2px 8px;\n  border-radius: var(--radius-sm);\n  background: #f1f5f9;\n  color: var(--color-ink);\n  font-size: 0.76rem;\n  font-weight: 700;\n}\n\n/* Slide-over Drawer UX */\n.admin-slideover {\n  position: fixed;\n  inset: 0;\n  z-index: 50;\n  display: flex;\n  justify-content: flex-end;\n}\n\n.admin-slideover__scrim {\n  position: absolute;\n  inset: 0;\n  background: rgba(15, 23, 42, 0.45);\n  backdrop-filter: blur(2px);\n  animation: fadeIn 0.2s ease-out;\n}\n\n.admin-slideover__panel {\n  position: relative;\n  z-index: 1;\n  height: 100%;\n  width: 520px;\n  max-width: 100%;\n  background: var(--color-surface);\n  box-shadow: -4px 0 24px rgba(0, 0, 0, 0.14);\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n  animation: slideInRight 0.25s ease-out;\n}\n\n@keyframes fadeIn {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n@keyframes slideInRight {\n  from { transform: translateX(100%); }\n  to { transform: translateX(0); }\n}\n\n.admin-slideover__header {\n  display: flex;\n  align-items: start;\n  justify-content: space-between;\n  gap: 16px;\n  padding: 20px 24px;\n  border-bottom: var(--border-default);\n  background: #f8fafc;\n}\n\n.admin-slideover__title-wrap {\n  flex: 1;\n  min-width: 0;\n}\n\n.admin-slideover__heading {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  flex-wrap: wrap;\n}\n\n.admin-slideover__heading h2 {\n  margin: 0;\n  font-size: 1.25rem;\n  font-weight: 800;\n  color: var(--color-ink);\n}\n\n.admin-slideover__subtitle {\n  margin: 4px 0 0;\n  font-size: 0.85rem;\n  color: var(--color-text-secondary);\n}\n\n.admin-slideover__body {\n  flex: 1;\n  overflow-y: auto;\n  padding: 24px;\n  display: flex;\n  flex-direction: column;\n  gap: 20px;\n}\n\n.admin-slideover__footer {\n  padding: 16px 24px;\n  border-top: var(--border-default);\n  background: #f8fafc;\n}\n\n.admin-drawer-actions {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  flex-wrap: wrap;\n}\n\n.admin-detail-group {\n  border: var(--border-default);\n  border-radius: var(--radius-sm);\n  padding: 16px;\n  background: #ffffff;\n}\n\n.admin-detail-group--danger {\n  border-color: #fecaca;\n  background: #fff5f5;\n}\n\n.admin-detail-group--warning {\n  border-color: #fed7aa;\n  background: #fffaf0;\n}\n\n.admin-detail-group__title {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin: 0 0 12px;\n  font-size: 0.95rem;\n  font-weight: 800;\n  color: var(--color-ink);\n}\n\n.admin-detail-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 12px 16px;\n  margin: 0;\n}\n\n.admin-detail-grid dt {\n  font-size: 0.76rem;\n  color: var(--color-text-muted);\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  margin-bottom: 2px;\n}\n\n.admin-detail-grid dd {\n  margin: 0;\n  font-size: 0.88rem;\n  color: var(--color-ink);\n}\n\n.admin-detail-text {\n  margin: 0;\n  font-size: 0.88rem;\n  line-height: 1.5;\n  color: var(--color-ink);\n}\n\n.admin-detail-sub {\n  margin-top: 10px;\n  font-size: 0.85rem;\n  color: var(--color-text-secondary);\n}\n\n.admin-detail-sub p {\n  margin: 4px 0 0;\n}\n\n.admin-detail-meta {\n  margin-top: 12px;\n  font-size: 0.8rem;\n  color: var(--color-text-muted);\n}\n\n/* Verification Documents */\n.admin-verification-docs {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.admin-doc-item {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 10px 14px;\n  border: var(--border-default);\n  border-radius: var(--radius-sm);\n  background: #f8fafc;\n}\n\n.admin-doc-item__icon {\n  color: var(--color-brand);\n}\n\n.admin-doc-item__info {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n\n.admin-doc-item__info strong {\n  font-size: 0.85rem;\n}\n\n.admin-doc-item__info small {\n  color: var(--color-text-muted);\n  font-size: 0.75rem;\n}\n\n/* Forms & Dialog Boxes */\n.admin-reject-box {\n  padding: 14px;\n  border-radius: var(--radius-sm);\n  border: 1px solid #fecaca;\n  background: #fef2f2;\n}\n\n.admin-reject-box h4 {\n  margin: 0 0 4px;\n  font-size: 0.95rem;\n  color: #991b1b;\n}\n\n.admin-reject-box p {\n  margin: 0 0 10px;\n  font-size: 0.82rem;\n  color: #b91c1c;\n}\n\n.admin-reject-box__actions {\n  display: flex;\n  gap: 8px;\n  margin-top: 10px;\n}\n\n.admin-textarea {\n  width: 100%;\n  padding: 8px 12px;\n  border: var(--border-default);\n  border-radius: var(--radius-sm);\n  font-family: inherit;\n  font-size: 0.85rem;\n  resize: vertical;\n}\n\n.admin-select {\n  width: 100%;\n  height: 38px;\n  padding: 0 10px;\n  border: var(--border-default);\n  border-radius: var(--radius-sm);\n  font-family: inherit;\n  font-size: 0.85rem;\n  background: var(--color-surface);\n}\n\n.admin-form-field {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  margin-top: 12px;\n}\n\n.admin-form-field label {\n  font-size: 0.82rem;\n  font-weight: 700;\n  color: var(--color-ink);\n}\n\n.admin-required-star {\n  color: var(--color-danger);\n  font-weight: normal;\n}\n\n.admin-form-error {\n  margin: 4px 0 0;\n  font-size: 0.78rem;\n  color: var(--color-danger);\n  font-weight: 600;\n}\n\n.admin-review-quote {\n  margin: 0;\n  padding: 12px 16px;\n  border-left: 3px solid var(--color-brand);\n  background: #f8fafc;\n  font-style: italic;\n  font-size: 0.9rem;\n  line-height: 1.5;\n  color: var(--color-ink);\n}\n\n.admin-rating-display {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.admin-rating-stars {\n  display: flex;\n  gap: 3px;\n}\n\n.admin-rating-stars .star-filled {\n  color: #f59e0b;\n  fill: #f59e0b;\n}\n\n.admin-rating-stars .star-empty {\n  color: #cbd5e1;\n}\n\n.admin-issue-desc-box {\n  padding: 12px 14px;\n  border-radius: var(--radius-sm);\n  background: #f8fafc;\n  border: var(--border-default);\n}\n\n.admin-issue-desc-box p {\n  margin: 0;\n  font-size: 0.88rem;\n  line-height: 1.5;\n}\n\n.admin-link-more {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  font-size: 0.82rem;\n  font-weight: 700;\n  color: var(--color-brand);\n}\n\n.admin-link-more:hover {\n  text-decoration: underline;\n}\n\n.admin-section__heading-right {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  flex-wrap: wrap;\n}\n\n.admin-subgrid { display: grid; min-width: 0; gap: 20px; }\n\n/* Two-party Inspection & Trust Metrics */\n.admin-parties-grid {\n  display: grid;\n  grid-template-columns: 1fr;\n  gap: 12px;\n  margin-top: 8px;\n}\n\n.admin-party-card {\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  padding: 12px 14px;\n  background: #f8fafc;\n  border: var(--border-default);\n  border-radius: var(--radius-sm);\n  position: relative;\n}\n\n.admin-party-card__role-tag {\n  font-size: 0.72rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  color: var(--color-text-muted);\n}\n\n.admin-party-card__user {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.admin-party-card__user-info {\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n}\n\n.admin-party-card__user-info strong {\n  font-size: 0.88rem;\n  font-weight: 700;\n  color: var(--color-ink);\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.admin-party-card__user-info small {\n  font-size: 0.76rem;\n  color: var(--color-text-muted);\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.admin-party-contacts {\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n  padding-top: 8px;\n  border-top: 1px dashed #e2e8f0;\n}\n\n.admin-party-contact-item {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 0.78rem;\n  color: #475569;\n}\n\n.admin-party-contact-item svg {\n  color: #94a3b8;\n  flex-shrink: 0;\n}\n\n.admin-party-contact-item span {\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.admin-party-trust-badge {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 6px 10px;\n  border-radius: var(--radius-sm);\n  font-size: 0.78rem;\n  font-weight: 600;\n  background: #f1f5f9;\n  color: #334155;\n  margin-top: 2px;\n  gap: 12px;\n  border: var(--border-default);\n  min-height: 44px;\n  text-align: left;\n  flex-wrap: wrap;\n}\n\n.admin-party-trust-badge--reporter {\n  background: #f1f5f9;\n  color: #334155;\n}\n\n.admin-party-trust-badge--warn-0 {\n  background: #ecfdf5;\n  color: #065f46;\n}\n\n.admin-party-trust-badge--warn-1 {\n  background: #fefce8;\n  color: #854d0e;\n}\n\n.admin-party-trust-badge--warn-2 {\n  background: #fff7ed;\n  color: #9a3412;\n}\n\n.admin-party-trust-badge--warn-3,\n.admin-party-trust-badge--warn-4 {\n  background: #fef2f2;\n  color: #991b1b;\n}\n\n.admin-party-trust-right {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.admin-warning-meter {\n  display: inline-flex;\n  align-items: center;\n  gap: 3px;\n}\n\n.admin-warning-meter__bar {\n  width: 14px;\n  height: 6px;\n  border-radius: 2px;\n  background: #cbd5e1;\n  display: inline-block;\n}\n\n.admin-warning-meter__bar.is-active.is-level-1 {\n  background: #eab308;\n}\n\n.admin-warning-meter__bar.is-active.is-level-2 {\n  background: #f97316;\n}\n\n.admin-warning-meter__bar.is-active.is-level-3 {\n  background: #ef4444;\n}\n\n.admin-party-alert {\n  font-size: 0.76rem;\n  padding: 6px 8px;\n  border-radius: var(--radius-sm);\n  line-height: 1.4;\n  margin-top: 4px;\n}\n\n.admin-party-alert--danger {\n  background: #fef2f2;\n  color: #991b1b;\n  border: 1px solid #fecaca;\n}\n\n.admin-party-alert--suspended {\n  background: #f1f5f9;\n  color: #475569;\n  border: 1px solid #cbd5e1;\n}\n\n/* Dispute & Report Resolution Actions */\n.admin-action-tabs {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n  border-bottom: 1px solid #e2e8f0;\n  padding-bottom: 8px;\n  margin-bottom: 12px;\n}\n\n.admin-action-tab {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 6px 12px;\n  font-size: 0.8rem;\n  font-weight: 600;\n  border-radius: var(--radius-sm);\n  border: 1px solid #e2e8f0;\n  background: #ffffff;\n  color: #64748b;\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n\n.admin-action-tab:hover {\n  background: #f8fafc;\n  color: var(--color-ink);\n}\n\n.admin-action-tab.is-active {\n  background: #f1f5f9;\n  border-color: #cbd5e1;\n  color: var(--color-ink);\n}\n\n.admin-action-tab.is-active.is-warn {\n  background: #fff7ed;\n  border-color: #fdba74;\n  color: #c2410c;\n}\n\n.admin-action-tab.is-active.is-dismiss {\n  background: #f8fafc;\n  border-color: #cbd5e1;\n  color: #475569;\n}\n\n.admin-action-panel {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n\n.admin-action-callout {\n  padding: 10px 12px;\n  border-radius: var(--radius-sm);\n  font-size: 0.82rem;\n  line-height: 1.45;\n}\n\n.admin-action-callout strong {\n  display: block;\n  margin-bottom: 3px;\n}\n\n.admin-action-callout p {\n  margin: 0;\n}\n\n.admin-action-callout--warn {\n  background: #fffbeb;\n  border: 1px solid #fde68a;\n  color: #92400e;\n}\n\n.admin-action-callout--danger {\n  background: #fef2f2;\n  border: 1px solid #fecaca;\n  color: #991b1b;\n}\n\n.admin-action-callout--info {\n  background: #eff6ff;\n  border: 1px solid #bfdbfe;\n  color: #1e40af;\n}\n\n.admin-resolution-box {\n  padding: 12px 14px;\n  border-radius: var(--radius-sm);\n  border: 1px solid #bbf7d0;\n  background: #f0fdf4;\n  margin-top: 10px;\n}\n\n.admin-resolution-box--warn {\n  border-color: #fed7aa;\n  background: #fff7ed;\n}\n\n.admin-resolution-box--dismiss {\n  border-color: #e2e8f0;\n  background: #f8fafc;\n}\n\n.admin-resolution-box__header {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 0.85rem;\n  font-weight: 700;\n  margin-bottom: 4px;\n}\n\n.admin-resolution-box p {\n  margin: 4px 0 0;\n  font-size: 0.83rem;\n  line-height: 1.45;\n}\n\n.admin-resolution-box small {\n  display: block;\n  margin-top: 6px;\n  font-size: 0.75rem;\n  color: var(--color-text-muted);\n}\n\n.admin-closed-issue-note {\n  margin: 0;\n  font-size: 0.84rem;\n  color: var(--color-text-muted);\n  font-style: italic;\n}\n\n@media (max-width: 1023px) {\n  .admin-slideover__panel {\n    width: 75%;\n  }\n}\n\n@media (max-width: 767px) {\n  .admin-slideover__panel {\n    width: 100%;\n  }\n  .admin-filter-bar {\n    flex-direction: column;\n    align-items: stretch;\n    gap: 10px;\n  }\n  .admin-tabs {\n    overflow-x: auto;\n    padding-bottom: 4px;\n    scrollbar-width: none;\n    -webkit-overflow-scrolling: touch;\n  }\n  .admin-tab {\n    white-space: nowrap;\n    flex: none;\n  }\n  .admin-filter-bar__search {\n    width: 100%;\n    min-width: 0;\n  }\n  .admin-detail-grid {\n    grid-template-columns: 1fr;\n  }\n  .admin-parties-grid {\n    grid-template-columns: 1fr;\n  }\n  .admin-drawer-actions {\n    flex-direction: column;\n    align-items: stretch;\n  }\n  .admin-drawer-actions > * {\n    width: 100%;\n    justify-content: center;\n  }\n  .admin-reject-box__actions {\n    flex-direction: column;\n  }\n  .admin-reject-box__actions > button {\n    width: 100%;\n  }\n}\n\n/* Action feedback banners */\n.admin-feedback-banner {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 10px 16px;\n  margin-bottom: 16px;\n  border-radius: var(--radius-sm);\n  font-size: 0.86rem;\n  font-weight: 600;\n  animation: fadeIn 0.25s ease-out;\n}\n\n.admin-feedback-banner--success {\n  background: #ecfdf5;\n  border: 1px solid #6ee7b7;\n  color: #065f46;\n}\n\n.admin-feedback-banner--danger {\n  background: #fef2f2;\n  border: 1px solid #fca5a5;\n  color: #991b1b;\n}\n\n.admin-feedback-banner--info {\n  background: #eff6ff;\n  border: 1px solid #93c5fd;\n  color: #1e40af;\n}\n\n.admin-feedback-banner button {\n  margin-left: auto;\n  border: 0;\n  background: transparent;\n  cursor: pointer;\n  color: inherit;\n  opacity: 0.7;\n  display: flex;\n  align-items: center;\n}\n\n.admin-feedback-banner button:hover {\n  opacity: 1;\n}\n\n/* Financial actions keep their full hit target in their own table cell. */\n.admin-table--finance-payouts { min-width: 1050px; }\n.admin-table--finance-payouts th:last-child,\n.admin-table--finance-payouts td:last-child { width: 210px; min-width: 210px; }\n.admin-finance-actions { display: flex; flex-direction: column; align-items: stretch; gap: 8px; }\n.admin-finance-actions .button { min-width: 0; width: 100%; white-space: normal; }\n.admin-document-preview { display: block; max-width: 100%; width: 200px; max-height: 150px; object-fit: contain; margin-top: 8px; border: 1px solid var(--color-border); border-radius: var(--radius-sm); }\n"],["STYLE",{},".public-page { overflow: clip; background: #fff; color: var(--text-primary); font-family: var(--font-ui); }\r\n.public-page *, .public-page *::before, .public-page *::after { box-sizing: border-box; }\r\n.public-page h1, .public-page h2, .public-page h3, .public-page p { margin-top: 0; }\r\n.public-page h1, .public-page h2, .public-page h3 { font-family: var(--font-display); letter-spacing: -.045em; }\r\n.public-wrap { width: min(var(--container-public), calc(100% - 84px)); margin-inline: auto; }\r\n.public-header { position: sticky; top: 0; z-index: 60; height: 86px; margin: 0 16px; border: 1px solid rgb(170 191 229 / 35%); border-top: 0; border-radius: 0 0 30px 30px; background: rgb(246 249 255 / 92%); box-shadow: 0 10px 32px rgb(22 48 91 / 8%); transition: background .22s ease, box-shadow .22s ease, border-color .22s ease; }\r\n.public-page--learner .public-header, .public-page--tutor .public-header { background: rgb(232 237 250 / 95%); border-color: rgb(255 255 255 / 62%); }\r\n.public-header.is-scrolled { background: rgb(239 245 255 / 72%); backdrop-filter: blur(22px) saturate(155%); -webkit-backdrop-filter: blur(22px) saturate(155%); box-shadow: 0 18px 48px rgb(11 31 64 / 16%); border-color: rgb(255 255 255 / 60%); }\r\n.public-page--tutor .public-header { height: 76px; }\r\n.public-header__inner { display: flex; align-items: center; gap: 26px; height: 100%; padding: 0 40px; }\r\n.public-brand { display: inline-flex; flex: none; align-items: center; gap: 11px; color: var(--text-primary); line-height: 1; }\r\n.public-brand__mark { display: grid; place-items: center; width: 45px; height: 45px; border-radius: 12px; background: #2465ea; color: #fff; font-family: var(--font-display); font-weight: 800; box-shadow: 0 5px 12px #1f5cd445; }\r\n.public-brand strong { display: block; font-size: 18px; font-weight: 800; letter-spacing: -.04em; }\r\n.public-brand small { display: block; margin-top: 5px; color: #727b98; font-size: 10px; font-weight: 700; letter-spacing: .01em; }\r\n.public-nav { display: flex; align-items: center; justify-content: center; gap: clamp(15px, 2.1vw, 32px); flex: 1; white-space: nowrap; }\r\n.public-nav a { color: #25304d; font-size: 13px; font-weight: 800; }\r\n.public-nav a:hover { color: #1556d5; }\r\n.public-nav > a { position: relative; padding-block: 8px; }\r\n.public-nav > a::after { content: ''; position: absolute; left: 0; right: 100%; bottom: -1px; height: 2px; background: var(--brand-learner-orange); transition: right .18s ease; }\r\n.public-nav > a:hover::after, .public-nav > a:focus-visible::after { right: 0; }\r\n.public-page--learner .public-nav > a::after, .public-page--tutor .public-nav > a::after { background: var(--brand-accent-yellow); }\r\n.public-nav__mobile, .public-header__menu { display: none; }\r\n.public-header__actions { display: flex; align-items: center; gap: 9px; flex: none; }\r\n.public-header__actions > * { display: inline-grid; place-items: center; min-height: 45px; padding: 0 17px; border-radius: 12px; font-weight: 900; white-space: nowrap; box-shadow: 0 4px 13px #1b28651c; transition: transform .18s ease, box-shadow .18s ease, background .18s ease; }\r\n.public-header__yellow { background: #ffc83f; color: #323045; font-size: 13px; }\r\n.public-header__plain { background: #fff; color: #1a253d; }\r\n.public-header__blue { background: #2163e7; color: #fff; }\r\n.public-header__actions > *:hover { transform: translateY(-1px); box-shadow: 0 8px 22px rgb(27 40 101 / 20%); }\r\n.public-header__blue:hover { background: #0f47b8; }\r\n.public-btn:hover { transform: translateY(-2px); }\r\n.public-hero { position: relative; margin-top: -86px; padding: 175px 0 95px; color: #fff; }\r\n.public-hero--home { background: radial-gradient(circle at 101% 10%, #ffce4d 0 10%, transparent 10.2%), radial-gradient(circle at 88% 66%, #772d9f 0 21%, transparent 45%), linear-gradient(120deg, #1b3eae, #292f91 70%); }\r\n.public-hero--learner { background: radial-gradient(circle at 99% 7%, #eb2d4c 0 17%, transparent 17.2%), linear-gradient(112deg, #fa7d2e, #f45630 62%, #e84151); }\r\n.public-hero--tutor { margin-top: -76px; padding-top: 165px; background: radial-gradient(circle at 98% 5%, #ee2c43 0 17%, transparent 17.2%), linear-gradient(110deg, #174396, #1956b3 70%, #245fc3); }\r\n.public-hero__grid { display: grid; grid-template-columns: 1.08fr .92fr; align-items: center; gap: 28px; min-height: 480px; }\r\n.public-hero__copy { position: relative; z-index: 2; max-width: 650px; }\r\n.public-hero__eyebrow { display: inline-block; margin-bottom: 20px; color: #ffe475; font-size: 12px; font-weight: 900; letter-spacing: .15em; }\r\n.public-hero--home .public-hero__eyebrow { padding: 7px 13px; border: 1px solid #ffffff38; border-radius: 30px; background: #ffffff1a; font-size: 16px; }\r\n.public-hero__copy h1 { margin-bottom: 25px; font-size: clamp(44px, 4.35vw, 70px); font-weight: 800; line-height: 1.07; }\r\n.public-hero--home .public-hero__copy h1 { font-size: clamp(45px, 4.15vw, 68px); }\r\n.public-hero--learner .public-hero__copy h1 { font-size: clamp(48px, 4.3vw, 68px); }\r\n.public-hero__copy h1 em { color: #ffdc5c; font-style: normal; }\r\n.public-hero__copy > p { max-width: 610px; margin-bottom: 31px; font-size: 18px; line-height: 1.65; }\r\n.public-hero__actions { display: flex; align-items: center; flex-wrap: wrap; gap: 13px; }\r\n.public-btn { display: inline-flex; align-items: center; justify-content: center; gap: 11px; min-height: 52px; padding: 12px 23px; border: 1px solid transparent; border-radius: 13px; font-size: 15px; font-weight: 900; line-height: 1.2; cursor: pointer; transition: transform .16s ease, background .16s ease, border-color .16s ease; }\r\n.public-btn--yellow { background: #ffda43; color: #172344; box-shadow: 0 7px 18px #29284425; }\r\n.public-btn--blue { background: #205ee0; color: #fff; }\r\n.public-btn--red { background: #e93246; color: #fff; }\r\n.public-btn--outline { border-color: #ffffff8a; background: transparent; color: #fff; }\r\n.public-btn--outline-blue { border-color: #1b58c8; background: #fff; color: #154cae; }\r\n.public-hero__text-link { color: #fff; font-weight: 900; border-bottom: 1px solid #ffffff80; padding-bottom: 6px; }\r\n.public-hero__proof { display: flex; flex-wrap: wrap; gap: 21px; margin-top: 32px; color: #e9ecff; font-size: 13px; }\r\n.public-hero__proof span { display: inline-flex; align-items: center; gap: 5px; }\r\n.public-hero__proof strong { color: #ffde58; }\r\n.public-hero__visual { position: relative; height: 485px; }\r\n.public-hero__visual::before { content: ''; position: absolute; width: 75px; height: 75px; left: -8%; top: 0; border-radius: 50%; background: #3eb7ed88; }\r\n.public-hero__photo-main { position: absolute; top: 8%; right: 0; width: 77%; height: 88%; object-fit: cover; border: 6px solid #fff; border-radius: 39px; transform: rotate(2deg); box-shadow: 0 25px 55px #0b174742; }\r\n.public-hero__photo-side { position: absolute; bottom: -6%; left: 0; width: 40%; height: 40%; object-fit: cover; border: 5px solid #fff; border-radius: 30px; transform: rotate(-7deg); box-shadow: 0 16px 30px #0b174747; }\r\n.public-page--learner .public-hero__photo-side, .public-page--tutor .public-hero__photo-side { border-color: #ffd844; }\r\n.public-float { position: absolute; z-index: 2; display: flex; align-items: center; gap: 7px; min-height: 65px; padding: 12px 15px; border-radius: 17px; background: #fff; color: #16233f; box-shadow: 0 12px 26px #101a4630; transform: rotate(-2deg); }\r\n.public-float svg { color: #e73a4b; }\r\n.public-float b { display: block; line-height: 1; }\r\n.public-float small { display: block; max-width: 98px; color: #5b6478; font-size: 11px; line-height: 1.25; }\r\n.public-float--rating, .public-float--yellow { top: 15%; left: 0; }\r\n.public-float--location { bottom: 7%; right: -4%; }\r\n.public-float--yellow { display: block; background: #ffdb49; transform: rotate(-6deg); }\r\n.public-float--yellow small { max-width: 160px; margin-top: 4px; color: #29304a; }\r\n.public-shortcuts { position: relative; z-index: 3; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; margin-top: -29px; border-radius: 19px; overflow: hidden; background: #fff; box-shadow: 0 20px 50px #17327623; }\r\n.public-shortcuts a { display: flex; align-items: center; gap: 12px; min-height: 91px; padding: 17px 20px; border-right: 1px solid #e3e8f2; }\r\n.public-shortcuts a:last-child { border: 0; }\r\n.public-shortcuts svg { flex: none; color: var(--brand-primary); }\r\n.public-shortcuts span { display: grid; gap: 3px; min-width: 0; }\r\n.public-shortcuts strong { font-size: 14px; }\r\n.public-shortcuts small { color: var(--text-muted); font-size: 11px; }\r\n.public-shortcuts a > svg:last-child { margin-left: auto; width: 16px; }\r\n.public-section { padding: 94px 0; }\r\n.public-kicker { display: inline-block; margin-bottom: 13px; color: var(--brand-accent-red); font-size: 12px; font-weight: 900; letter-spacing: .12em; }\r\n.public-section-head { max-width: 750px; }\r\n.public-section-head h2 { margin-bottom: 15px; font-size: clamp(32px, 3.2vw, 48px); line-height: 1.13; font-weight: 800; }\r\n.public-section-head p { max-width: 620px; color: var(--text-muted); font-size: 16px; line-height: 1.65; }\r\n.public-section-head--light .public-kicker { color: #ffdf63; }\r\n.public-section-head--light p { color: #e7ebff; }\r\n.public-finder { background: var(--surface-warm); }\r\n.public-finder__intro { display: flex; justify-content: space-between; align-items: end; gap: 24px; margin-bottom: 26px; }\r\n.public-finder__intro h2 { max-width: 670px; margin-bottom: 9px; font-size: clamp(30px, 3.2vw, 46px); line-height: 1.15; }\r\n.public-finder__intro h2 em { color: var(--brand-primary); font-style: normal; }\r\n.public-finder__intro p { max-width: 490px; margin: 0; color: var(--text-muted); line-height: 1.55; }\r\n.public-finder__note { flex: none; padding: 14px 18px; border-radius: 13px; background: #ffdb48; font-weight: 900; transform: rotate(2deg); }\r\n.public-finder__note small { font-weight: 600; }\r\n.public-finder__fields { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)) auto; align-items: end; gap: 12px; padding: 19px; border: 1px solid #f2e3c3; border-radius: 19px; background: #fff; box-shadow: 0 13px 35px #66532416; }\r\n.public-finder__fields label, .public-tutor-setup__fields label, .public-consult__form label { display: grid; gap: 7px; min-width: 0; font-size: 13px; font-weight: 900; }\r\n.public-page select, .public-page input:not([type=range]), .public-page textarea { width: 100%; min-height: 48px; padding: 10px 14px; border: 1px solid #d9e2f0; border-radius: 10px; background: #fff; color: var(--text-primary); font: inherit; font-size: 15px; }\r\n.public-page textarea { min-height: 90px; resize: vertical; }\r\n.public-finder__hint { margin: 14px 0 0; color: var(--text-muted); font-size: 13px; }\r\n.public-needs { background: #fff; }\r\n.public-needs__grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 20px; margin-top: 37px; }\r\n.public-need-card { overflow: hidden; border-radius: 21px; background: #eaf6ff; }\r\n.public-need-card img { width: 100%; height: 210px; object-fit: cover; }\r\n.public-need-card div { padding: 23px 25px 27px; }\r\n.public-need-card span, .public-stories article span, .public-learner-stories article span { color: #1b55ad; font-size: 11px; font-weight: 900; letter-spacing: .1em; }\r\n.public-need-card h3 { margin: 9px 0 8px; font-size: 24px; line-height: 1.15; }\r\n.public-need-card p { min-height: 48px; margin-bottom: 18px; color: var(--text-muted); font-size: 14px; }\r\n.public-need-card b { display: inline-flex; align-items: center; gap: 8px; color: #134aa9; font-size: 14px; }\r\n.public-need-card--red { background: #fff0ed; }.public-need-card--yellow { background: #fff4c8; }\r\n.public-featured { background: #f5f8ff; }\r\n.public-featured__head, .public-results-head { display: flex; justify-content: space-between; align-items: end; gap: 24px; margin-bottom: 28px; }\r\n.public-featured__grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 18px; }\r\n.public-tutor-card { display: grid; grid-template-columns: 138px minmax(0,1fr); min-width: 0; overflow: hidden; border: 1px solid #dfe6f2; border-radius: 18px; background: #fff; }\r\n.public-tutor-card--featured { grid-column: 1/-1; grid-template-columns: 280px minmax(0,1fr); }\r\n.public-tutor-card__portrait { display: grid; place-items: center; min-height: 100%; background: #d9ecff; font-family: var(--font-display); font-size: 40px; font-weight: 900; color: #1a56b8; }\r\n.public-tutor-card__portrait img, .public-tutor-card__portrait span { grid-area: 1/1; }.public-tutor-card__portrait img { width: 100%; height: 100%; min-height: 215px; object-fit: cover; }.public-tutor-card__portrait img[hidden] { display: none; }.public-tutor-card__portrait img:not([hidden]) + span { display: none; }\r\n.public-tutor-card--featured .public-tutor-card__portrait { font-size: 72px; }\r\n.public-tutor-card__portrait.tone-coral { background: #ffe5dc; color: #ca3d36; }.public-tutor-card__portrait.tone-yellow { background: #ffedaa; color: #a5640a; }.public-tutor-card__portrait.tone-cyan { background: #d4f5fc; color: #087f9a; }\r\n.public-tutor-card__content { padding: 20px; min-width: 0; }\r\n.public-tutor-card__top { display: flex; justify-content: space-between; align-items: center; gap: 8px; }\r\n.public-tag { display: inline-flex; align-items: center; gap: 4px; color: var(--status-success); font-size: 11px; font-weight: 800; }\r\n.public-save { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: #f2f5fb; color: #415276; }.public-save.is-saved { background: #eaf2ff; color: #205ee0; }\r\n.public-tutor-card h3 { margin: 7px 0 2px; font-size: 24px; }.public-tutor-card__university { margin-bottom: 8px; color: var(--text-muted); font-size: 12px; }\r\n.public-tutor-card__rating { display: flex; align-items: center; gap: 5px; color: #e2a511; font-size: 13px; }.public-tutor-card__rating span { color: var(--text-muted); }\r\n.public-tutor-card__bio { margin: 12px 0; color: var(--text-muted); font-size: 13px; line-height: 1.55; }\r\n.public-tutor-card__facts { display: flex; flex-wrap: wrap; gap: 7px; }.public-tutor-card__facts span { display: inline-flex; align-items: center; gap: 4px; padding: 5px 8px; border-radius: 6px; background: #edf4ff; color: #28559d; font-size: 11px; font-weight: 800; }\r\n.public-tutor-card__bottom { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 16px; padding-top: 14px; border-top: 1px solid #e6ebf4; }.public-tutor-card__bottom strong { color: #1649ab; font-size: 18px; }.public-tutor-card__bottom small { color: var(--text-muted); font-size: 11px; }.public-tutor-card__bottom .public-btn { min-height: 39px; padding: 8px 12px; font-size: 12px; }\r\n.public-community { background: #263ba5; color: #fff; }.public-community__grid { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 70px; }.public-community__image { position: relative; }.public-community__image img { width: 100%; height: 370px; object-fit: cover; border-radius: 28px; }.public-community__image span { position: absolute; bottom: -13px; right: -15px; max-width: 230px; padding: 19px; border-radius: 14px; background: #ffda48; color: #1c2842; font-weight: 900; }.public-community__numbers { display: flex; gap: 28px; margin-top: 36px; }.public-community__numbers span { display: grid; max-width: 130px; color: #e4eaff; font-size: 12px; }.public-community__numbers strong { color: #ffdb4c; font-size: 26px; }\r\n.public-map-section { background: #f6f9ff; }.public-map-section__grid { display: grid; grid-template-columns: .8fr 1.2fr; align-items: center; gap: 65px; }.public-map-section ol { padding: 0; margin: 25px 0; list-style: none; }.public-map-section li { display: flex; align-items: start; gap: 13px; margin-bottom: 16px; }.public-map-section li b { color: #e9354c; }.public-map-section li span { display: grid; }.public-map-section li small { color: var(--text-muted); }\r\n.public-map { position: relative; min-height: 410px; overflow: hidden; border: 9px solid #fff; border-radius: 27px; background: repeating-linear-gradient(0deg, transparent 0 63px, #ffffff8d 64px 68px, transparent 69px 125px), repeating-linear-gradient(90deg, #e4eeef 0 83px, #ffffffa3 84px 89px, #e4eeef 90px 155px); box-shadow: 0 15px 45px #24377021; }.public-map__road { position: absolute; height: 24px; width: 130%; left: -15%; background: #fff9df; transform: rotate(-22deg); }.public-map__road--a { top: 24%; }.public-map__road--b { top: 65%; transform: rotate(28deg); }.public-map__road--c { top: 85%; transform: rotate(-5deg); }.public-map__park { position: absolute; left: 12%; top: 13%; width: 30%; height: 29%; border-radius: 45%; background: #cce9d6; }.public-map__area { position: absolute; z-index: 1; color: #617a9b; font-size: 11px; font-weight: 900; letter-spacing: .1em; }.public-map__area--a { left: 46%; top: 18%; }.public-map__area--b { right: 7%; top: 56%; }.public-map__area--c { left: 12%; bottom: 22%; }.public-map__pin { position: absolute; z-index: 2; display: grid; place-items: center; width: 42px; height: 42px; border: 3px solid #fff; border-radius: 50%; background: #ed4254; color: #fff; box-shadow: 0 5px 13px #273a7040; }.public-map__pin.is-active { background: #1653bd; transform: scale(1.14); }.public-map__tooltip { position: absolute; z-index: 3; left: 50%; bottom: 17%; display: flex; align-items: center; gap: 10px; min-width: 210px; padding: 10px; border-radius: 13px; background: #fff; box-shadow: 0 9px 24px #23376b36; transform: translateX(-50%); }.public-map__tooltip-avatar { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 8px; background: #dbe9ff; color: #164cad; font-size: 12px; font-weight: 900; }.public-map__tooltip strong, .public-map__tooltip small { display: block; }.public-map__tooltip strong { font-size: 12px; }.public-map__tooltip small { color: var(--text-muted); font-size: 10px; }.public-map__tooltip button { margin-left: auto; color: #1653bd; background: transparent; }.public-map__notice { position: absolute; bottom: 9px; left: 14px; color: #445a7b; font-size: 10px; font-weight: 800; }\r\n.public-consult { background: #fff; }.public-consult__grid { display: grid; grid-template-columns: .85fr 1.15fr; gap: 45px; align-items: center; }.public-consult__photo { position: relative; }.public-consult__photo img { width: 100%; height: 600px; object-fit: cover; border-radius: 28px; }.public-consult__photo span { position: absolute; bottom: 25px; left: 25px; padding: 15px 20px; border-radius: 14px; background: #ffdd4c; font-weight: 900; }.public-consult__form { padding: 30px; border-radius: 24px; background: #f4f8ff; }.public-consult__form h2 { font-size: 38px; line-height: 1.14; }.public-consult__form p { color: var(--text-muted); }.public-consult__form > div { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px; }.public-consult__form > label { margin-bottom: 17px; }.public-form-success { margin: 13px 0 0; color: var(--status-success) !important; font-weight: 800; }\r\n.public-offer { background: #e83146; color: #fff; }.public-offer__grid { display: flex; justify-content: space-between; align-items: center; gap: 40px; }.public-offer h2, .public-become h2, .public-final h2 { font-size: clamp(35px,4vw,56px); line-height: 1.1; }.public-offer p { max-width: 600px; font-size: 18px; }.public-offer small { display: block; margin-top: 17px; }.public-offer .public-kicker { color: #ffe067; }.public-offer__number { font-family: var(--font-display); font-size: clamp(100px,15vw,220px); line-height: .85; color: #ffdc47; transform: rotate(-10deg); }.public-offer__number span { font-size: .45em; }\r\n.public-steps { background: #fff9ea; }.public-steps__grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 35px; margin-top: 40px; }.public-steps__grid > div { padding: 0 26px 0 0; border-right: 1px solid #eadcbf; }.public-steps__grid > div:last-child { border: 0; }.public-steps__grid b { color: #e83449; font-size: 38px; }.public-steps__grid h3 { margin: 17px 0 9px; font-size: 25px; }.public-steps__grid p { color: var(--text-muted); }\r\n.public-stories { background: #fff; }.public-stories__grid { display: grid; grid-template-columns: 1.5fr 1fr 1fr; gap: 22px; margin-top: 34px; }.public-stories article { padding: 23px; border-radius: 20px; background: #f1f7ff; }.public-stories article:first-child { padding: 0 0 23px; overflow: hidden; }.public-stories article:first-child > :not(img) { margin-left: 23px; margin-right: 23px; }.public-stories img { width: 100%; height: 200px; margin-bottom: 20px; object-fit: cover; }.public-stories h3 { margin: 10px 0; font-size: 23px; }.public-stories p { color: var(--text-muted); }\r\n.public-become { background: #732fa3; color: #fff; }.public-become__grid { display: grid; grid-template-columns: 1.4fr .6fr; align-items: center; gap: 40px; }.public-become .public-kicker { color: #ffdf64; }.public-become p { max-width: 650px; font-size: 18px; }.public-become__icon { display: grid; justify-items: center; gap: 15px; color: #ffdc50; text-align: center; font-size: 18px; font-weight: 900; }\r\n.public-final { padding: 72px 0; background: #213ca2; color: #fff; text-align: center; }.public-final span { color: #ffda54; font-size: 12px; font-weight: 900; letter-spacing: .14em; }.public-final h2 { margin: 14px auto 24px; }.public-final p { color: #e6ecff; }\r\n.public-footer { padding: 65px 0 24px; background: #101b3a; color: #fff; }.public-footer__grid { display: grid; grid-template-columns: 2fr repeat(3,1fr); gap: 45px; }.public-footer .public-brand { color: #fff; }.public-footer p { max-width: 315px; margin-top: 18px; color: #b7c3de; font-size: 13px; }.public-footer__grid > div:not(:first-child) { display: grid; align-content: start; gap: 10px; }.public-footer__grid > div > strong { margin-bottom: 8px; }.public-footer__grid a:not(.public-brand) { color: #b7c3de; font-size: 13px; }.public-footer__bottom { margin-top: 50px; padding-top: 18px; border-top: 1px solid #ffffff26; color: #a8b8d4; font-size: 12px; }\r\n.public-dialog-backdrop { position: fixed; z-index: 100; inset: 0; display: grid; place-items: center; padding: 16px; background: #0c1943b8; }.public-dialog { position: relative; width: min(100%,520px); max-height: calc(100vh - 32px); overflow: auto; padding: 35px; border-radius: 22px; background: #fff; box-shadow: 0 30px 80px #0003; }.public-dialog h2 { margin-bottom: 10px; font-size: 31px; }.public-dialog p { color: var(--text-muted); line-height: 1.6; }.public-dialog__close { position: absolute; top: 18px; right: 18px; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: #eaf2ff; color: #1a51b1; }.public-dialog__links { display: flex; flex-wrap: wrap; gap: 14px; margin: 20px 0; }.public-dialog__links a { color: #1755c5; font-weight: 800; text-decoration: underline; }.public-dialog > .public-btn { margin-top: 10px; }\r\n\r\n/* Learner landing: brighter, more spacious discovery rhythm. */\r\n.public-learner-finder { padding: 70px 0; background: #fff9ec; }.public-finder__fields--four { grid-template-columns: repeat(4,minmax(0,1fr)) auto; }.public-finder__fields--four .public-btn { white-space: nowrap; }\r\n.public-learner-needs { background: #eef7ff; }.public-learner-needs__grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 15px; margin-top: 35px; }.public-learner-need { display: flex; flex-direction: column; align-items: start; min-height: 260px; padding: 25px; border-radius: 20px; text-align: left; transition: transform .16s ease; }.public-learner-need:hover { transform: translateY(-4px); }.public-learner-need span { font-size: 30px; font-weight: 900; }.public-learner-need h3 { margin: auto 0 10px; font-size: 23px; line-height: 1.15; }.public-learner-need p { margin: 0 0 16px; font-size: 13px; line-height: 1.5; }.public-learner-need svg { align-self: end; }.public-learner-need.tone-blue { background: #1853b7; color: #fff; }.public-learner-need.tone-red { background: #ed4950; color: #fff; }.public-learner-need.tone-yellow { background: #ffdc54; color: #263047; }.public-learner-need.tone-cyan { background: #66d6e9; color: #173458; }\r\n.public-learner-tutors { background: #fff; }.public-results-head__tools { display: flex; align-items: center; gap: 14px; flex: none; color: var(--text-muted); font-size: 13px; }.public-results-head__tools label { display: flex; align-items: center; gap: 7px; font-weight: 800; }.public-results-head__tools select { min-height: 38px; padding: 5px 8px; font-size: 13px; }.public-tutor-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 18px; }.public-section__end { display: flex; justify-content: center; margin-top: 30px; }.public-empty { display: grid; justify-items: center; gap: 10px; padding: 55px 20px; border: 1px dashed #bdcde5; border-radius: 20px; text-align: center; }.public-empty p { color: var(--text-muted); }\r\n.public-confidence { background: #1a3fa2; color: #fff; }.public-confidence__grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: 65px; align-items: center; }.public-confidence a { display: inline-flex; align-items: center; gap: 8px; margin-top: 14px; color: #ffdd5c; font-weight: 900; }.public-confidence__list { display: grid; grid-template-columns: 1fr 1fr; gap: 17px; }.public-confidence__list span { display: grid; gap: 12px; min-height: 140px; padding: 22px; border: 1px solid #ffffff4c; border-radius: 17px; background: #ffffff18; font-weight: 900; }.public-confidence__list svg { color: #ffdd5c; }\r\n.public-map-section--learner { background: #fffaf0; }.public-map-section--learner .public-map-section__grid { grid-template-columns: 1.1fr .9fr; }.public-privacy { display: flex; align-items: start; gap: 12px; margin-top: 25px; padding: 17px; border-left: 4px solid #22bceb; background: #eaf6ff; }.public-privacy svg { flex: none; color: #1b5ab9; }.public-privacy strong, .public-privacy small { display: block; }.public-privacy small { margin-top: 3px; color: var(--text-muted); }\r\n.public-learner-how { background: #eef7ff; text-align: center; }.public-learner-how .public-section-head { margin-inline: auto; }.public-learner-how .public-section-head p { margin-inline: auto; }.public-learner-how__grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 14px; margin-top: 40px; }.public-learner-how__grid > div { min-height: 215px; padding: 25px 20px; border-radius: 20px; background: #fff; text-align: left; }.public-learner-how__grid > div:nth-child(2) { background: #ffedac; }.public-learner-how__grid > div:nth-child(3) { background: #ffe1dd; }.public-learner-how__grid > div:nth-child(4) { background: #d8f5fb; }.public-learner-how__grid b { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; background: #1d59bd; color: #fff; }.public-learner-how__grid h3 { margin: 25px 0 8px; font-size: 21px; }.public-learner-how__grid p { color: var(--text-muted); font-size: 13px; }\r\n.public-learner-offer { background: #e93045; color: #fff; }.public-learner-offer__grid { display: grid; grid-template-columns: 1.3fr .7fr; gap: 30px; align-items: center; }.public-learner-offer h2 { max-width: 780px; font-size: clamp(35px,4vw,56px); }.public-learner-offer p { max-width: 590px; font-size: 18px; }.public-learner-offer .public-kicker { color: #ffde57; }.public-learner-offer__seal { display: grid; justify-items: center; gap: 20px; color: #ffdc54; text-align: center; font-size: 24px; }\r\n.public-learner-stories { background: #fff; }.public-learner-stories__grid { display: grid; grid-template-columns: 1.5fr 1fr 1fr; gap: 17px; margin-top: 34px; }.public-learner-stories article { padding: 24px; border-radius: 18px; background: #f1f6ff; }.public-learner-stories article:not(:first-child) { display: flex; flex-direction: column; justify-content: center; }.public-learner-stories article:not(:first-child) svg { margin-bottom: 20px; color: #1b59bd; }.public-learner-stories__feature { overflow: hidden; padding: 0 !important; }.public-learner-stories__feature img { width: 100%; height: 210px; object-fit: cover; }.public-learner-stories__feature div { padding: 22px; }.public-learner-stories h3 { margin: 11px 0; font-size: 22px; }.public-learner-stories p { color: var(--text-muted); font-size: 14px; }.public-learner-stories a { color: #1556bc; font-weight: 900; }.public-final--learner { background: #1346a0; }\r\n\r\n/* Tutor acquisition: blue workspace narrative, with operational controls. */\r\n.public-tutor-setup { padding: 75px 0; background: #fff8e8; }.public-tutor-setup__title { display: flex; align-items: center; gap: 20px; margin-bottom: 27px; }.public-tutor-setup__title > b { display: grid; place-items: center; width: 66px; height: 66px; border-radius: 17px; background: #ffdc49; color: #182344; font-size: 27px; }.public-tutor-setup h2 { margin-bottom: 0; font-size: clamp(29px,3.1vw,44px); }.public-tutor-setup__fields { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)) auto; align-items: end; gap: 11px; padding: 20px; border-radius: 19px; background: #fff; box-shadow: 0 16px 36px #664d1f15; }.public-tutor-setup__fields .public-btn { white-space: nowrap; }\r\n.public-opportunities { background: #f3f8ff; }.public-request-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 17px; }.public-request-card { min-width: 0; padding: 24px; border: 1px solid #e0e8f3; border-radius: 18px; background: #fff; }.public-request-card__top, .public-request-card__bottom { display: flex; justify-content: space-between; align-items: center; gap: 14px; }.public-request-card__top span { padding: 6px 11px; border-radius: 6px; background: #e8f1ff; color: #1552ad; font-size: 12px; font-weight: 900; }.public-request-card__top small { color: var(--text-muted); }.public-request-card h3 { min-height: 56px; margin: 18px 0 12px; font-size: 24px; line-height: 1.15; }.public-request-card__facts { display: flex; flex-wrap: wrap; gap: 9px 15px; color: var(--text-muted); font-size: 13px; }.public-request-card__facts span { display: inline-flex; align-items: center; gap: 5px; }.public-request-card__bottom { margin-top: 20px; padding-top: 17px; border-top: 1px solid #e4eaf2; }.public-request-card__bottom strong { color: #1650ae; font-size: 20px; }.public-request-card__bottom small { color: var(--text-muted); font-size: 12px; }.public-request-card__bottom button { display: flex; align-items: center; gap: 6px; background: transparent; color: #1650ae; font-weight: 900; }\r\n.public-tutor-income { background: #1c45a6; color: #fff; }.public-tutor-income__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 65px; align-items: center; }.public-tutor-income__mini { display: inline-flex; align-items: center; gap: 12px; margin-top: 24px; color: #ffdc5b; font-weight: 800; }.public-calculator { padding: 32px; border-radius: 24px; background: #fff; color: var(--text-primary); }.public-calculator label { display: grid; grid-template-columns: 1fr auto; gap: 10px; margin-bottom: 26px; font-size: 15px; font-weight: 800; }.public-calculator label strong { color: #1254bc; }.public-calculator input { grid-column: 1/-1; width: 100%; accent-color: #e9384a; }.public-calculator__result { display: flex; justify-content: space-between; gap: 15px; align-items: center; padding: 18px; border-radius: 15px; background: #ffde57; }.public-calculator__result span, .public-calculator__result small { display: block; }.public-calculator__result small { font-size: 11px; }.public-calculator__result strong { white-space: nowrap; font-size: 25px; }.public-calculator > small { display: block; margin-top: 16px; color: var(--text-muted); }\r\n.public-tutor-profile { background: #fff; }.public-tutor-profile__steps { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; margin: 32px 0 55px; }.public-tutor-profile__steps > div { padding: 25px; border-top: 5px solid #1a54b6; border-radius: 0 0 17px 17px; background: #f0f6ff; }.public-tutor-profile__steps > div:nth-child(2) { border-color: #f0c22c; background: #fff8df; }.public-tutor-profile__steps > div:nth-child(3) { border-color: #e84550; background: #fff0ed; }.public-tutor-profile__steps span { color: #1251b6; font-size: 26px; font-weight: 900; }.public-tutor-profile__steps h3 { margin: 13px 0 8px; font-size: 23px; }.public-tutor-profile__steps p { color: var(--text-muted); font-size: 14px; }.public-tutor-profile__lower { display: grid; grid-template-columns: 1.25fr .75fr; gap: 25px; }.public-availability, .public-privacy-card { padding: 28px; border-radius: 20px; background: #edf6ff; }.public-availability h3, .public-privacy-card h3 { font-size: 27px; }.public-availability p, .public-privacy-card p { color: var(--text-muted); }.public-availability__slots { display: flex; flex-wrap: wrap; gap: 9px; margin: 22px 0 13px; }.public-availability__slots button { display: inline-flex; align-items: center; gap: 3px; min-height: 42px; padding: 8px 14px; border: 1px solid #b9cbe5; border-radius: 9px; background: #fff; color: #31547e; font-weight: 800; }.public-availability__slots button.is-selected { border-color: #1655b8; background: #1655b8; color: #fff; }.public-availability > small { color: var(--text-muted); }.public-privacy-card { background: #fff0ed; }.public-privacy-card > svg { color: #e6444e; }.public-privacy-card button { display: inline-flex; align-items: center; gap: 7px; background: transparent; color: #1653b3; font-weight: 900; }.public-final--tutor { background: #e83047; text-align: left; }.public-final__row { display: flex; align-items: center; justify-content: space-between; gap: 25px; }.public-final__row h2 { margin-bottom: 10px; }\r\n\r\n@media (max-width: 1200px) {\r\n  .public-header__inner { padding: 0 25px; gap: 17px; }.public-nav { gap: 13px; }.public-nav a { font-size: 12px; }.public-header__actions > * { padding-inline: 12px; font-size: 12px; }\r\n  .public-wrap { width: min(var(--container-public), calc(100% - 48px)); }\r\n  .public-finder__fields--four, .public-tutor-setup__fields { grid-template-columns: repeat(4,minmax(0,1fr)); }.public-finder__fields--four .public-btn, .public-tutor-setup__fields .public-btn { grid-column: 1/-1; }\r\n  .public-learner-needs__grid { grid-template-columns: repeat(2,1fr); }\r\n}\r\n@media (max-width: 900px) {\r\n  .public-nav > a::after { display: none; }\r\n  .public-header, .public-page--tutor .public-header { height: 72px; }.public-header__inner { padding: 0 20px; }.public-header__menu { display: grid; place-items: center; width: 43px; height: 43px; margin-left: auto; border-radius: 10px; background: #fff; color: #1949ad; }.public-header__actions { margin-left: auto; }.public-nav { display: none; position: absolute; top: 72px; left: 0; right: 0; flex-direction: column; align-items: stretch; gap: 0; padding: 15px 20px 23px; border-radius: 0 0 20px 20px; background: #eef1ff; box-shadow: 0 20px 30px #0c1b5030; }.public-nav.is-open { display: flex; }.public-nav a { padding: 11px 5px; font-size: 15px; }.public-nav__mobile { display: grid; border-top: 1px solid #d6deef; }\r\n  .public-hero, .public-hero--tutor { margin-top: -72px; padding-top: 155px; }.public-hero__grid { grid-template-columns: 1fr 1fr; }.public-hero__copy h1, .public-hero--home .public-hero__copy h1, .public-hero--learner .public-hero__copy h1 { font-size: clamp(38px,4.6vw,55px); }.public-hero__copy > p { font-size: 16px; }.public-hero__visual { height: 390px; }.public-hero__photo-main { width: 85%; }.public-float--location { right: 0; }.public-float--yellow { left: -5%; }\r\n  .public-shortcuts { grid-template-columns: repeat(2,1fr); }.public-shortcuts a:nth-child(2) { border-right: 0; }.public-shortcuts a:nth-child(-n+2) { border-bottom: 1px solid #e3e8f2; }\r\n  .public-map-section__grid, .public-community__grid, .public-confidence__grid, .public-tutor-income__grid { gap: 30px; }.public-section { padding: 70px 0; }.public-tutor-card { grid-template-columns: 100px minmax(0,1fr); }.public-tutor-card--featured { grid-template-columns: 220px minmax(0,1fr); }.public-tutor-card__content { padding: 16px; }\r\n  .public-finder__fields { grid-template-columns: repeat(2,minmax(0,1fr)); }.public-finder__fields .public-btn { grid-column: 1/-1; }.public-stories__grid, .public-learner-stories__grid { grid-template-columns: 1fr 1fr; }.public-stories article:first-child, .public-learner-stories article:first-child { grid-column: 1/-1; }.public-tutor-profile__lower { grid-template-columns: 1fr 1fr; }\r\n}\r\n@media (max-width: 767px) {\r\n  .public-wrap { width: calc(100% - 36px); }.public-header { margin-inline: 8px; border-radius: 0 0 20px 20px; }.public-header__actions { display: none; }.public-header__menu { margin-left: auto; }.public-brand__mark { width: 40px; height: 40px; }.public-brand strong { font-size: 17px; }\r\n  .public-hero, .public-hero--tutor { padding: 132px 0 65px; }.public-hero__grid { grid-template-columns: 1fr; gap: 28px; min-height: 0; }.public-hero__copy h1, .public-hero--home .public-hero__copy h1, .public-hero--learner .public-hero__copy h1 { font-size: clamp(40px,10vw,54px); }.public-hero__eyebrow, .public-hero--home .public-hero__eyebrow { font-size: 10px; letter-spacing: .1em; }.public-hero__copy > p { font-size: 16px; }.public-hero__visual { height: 350px; }.public-hero__photo-main { width: 72%; right: 5%; }.public-hero__photo-side { width: 39%; left: 1%; }.public-float { min-height: 55px; padding: 9px 12px; }.public-float--rating, .public-float--yellow { left: 0; }.public-float--location { right: 0; }\r\n  .public-shortcuts { margin-top: 0; border-radius: 0; width: 100%; box-shadow: none; }.public-shortcuts a { min-height: 77px; padding: 12px; }.public-shortcuts a > svg:first-child { width: 20px; }.public-shortcuts a > svg:last-child { display: none; }.public-shortcuts strong { font-size: 12px; }.public-shortcuts small { font-size: 10px; }\r\n  .public-section { padding: 60px 0; }.public-section-head h2 { font-size: clamp(31px,8vw,40px); }.public-section-head p { font-size: 15px; }.public-finder__intro, .public-featured__head, .public-results-head { display: block; }.public-finder__note { display: none; }.public-featured__head > .public-btn { margin-top: 15px; }.public-results-head__tools { margin-top: 12px; justify-content: space-between; }.public-finder__fields, .public-finder__fields--four, .public-tutor-setup__fields { grid-template-columns: 1fr; }.public-finder__fields .public-btn, .public-finder__fields--four .public-btn, .public-tutor-setup__fields .public-btn { grid-column: auto; }\r\n  .public-needs__grid, .public-featured__grid, .public-tutor-grid, .public-request-grid, .public-community__grid, .public-map-section__grid, .public-map-section--learner .public-map-section__grid, .public-consult__grid, .public-steps__grid, .public-stories__grid, .public-become__grid, .public-learner-needs__grid, .public-confidence__grid, .public-learner-how__grid, .public-learner-offer__grid, .public-learner-stories__grid, .public-tutor-income__grid, .public-tutor-profile__steps, .public-tutor-profile__lower { grid-template-columns: 1fr; }\r\n  .public-tutor-card, .public-tutor-card--featured { grid-column: auto; grid-template-columns: 115px minmax(0,1fr); }.public-tutor-card__portrait, .public-tutor-card--featured .public-tutor-card__portrait { font-size: 32px; }.public-tutor-card__content { padding: 14px; }.public-tutor-card h3 { font-size: 19px; }.public-tutor-card__bio { display: none; }.public-tutor-card__facts span { font-size: 10px; }.public-tutor-card__bottom { display: block; }.public-tutor-card__bottom .public-btn { width: 100%; margin-top: 10px; }.public-map { min-height: 330px; }.public-map-section--learner .public-map { order: 2; }.public-community__numbers { gap: 12px; }.public-community__numbers strong { font-size: 20px; }.public-community__image img { height: 260px; }.public-consult__photo img { height: 280px; }.public-consult__form { padding: 20px; }.public-consult__form h2 { font-size: 31px; }.public-consult__form > div { grid-template-columns: 1fr; }.public-offer__number { display: none; }.public-steps__grid { gap: 20px; }.public-steps__grid > div { border: 0; border-bottom: 1px solid #eadcbf; padding-bottom: 15px; }.public-stories article:first-child, .public-learner-stories article:first-child { grid-column: auto; }.public-footer__grid { grid-template-columns: repeat(2,1fr); gap: 28px; }.public-footer__grid > div:first-child { grid-column: 1/-1; }.public-final__row { display: block; }.public-learner-need { min-height: 200px; }.public-learner-how__grid { gap: 10px; }.public-learner-how__grid > div { min-height: 0; }.public-confidence__list { gap: 10px; }.public-confidence__list span { min-height: 115px; padding: 16px; font-size: 12px; }.public-calculator { padding: 20px; }.public-calculator__result strong { font-size: 21px; }\r\n}\r\n@media (max-width: 390px) { .public-wrap { width: calc(100% - 28px); }.public-hero__copy h1, .public-hero--home .public-hero__copy h1, .public-hero--learner .public-hero__copy h1 { font-size: 39px; }.public-hero__visual { height: 300px; }.public-shortcuts small { display: none; }.public-tutor-card, .public-tutor-card--featured { grid-template-columns: 88px minmax(0,1fr); }.public-tutor-card__facts span:last-child { display: none; }.public-results-head__tools { flex-wrap: wrap; }.public-footer__grid { gap: 18px; } }\r\n"],["STYLE",{},".auth-page { --auth-blue: var(--brand-primary); --auth-blue-deep: var(--brand-primary-deep); --auth-red: var(--brand-accent-red); --auth-cyan: var(--brand-accent-cyan); --auth-yellow: var(--brand-accent-yellow); --auth-ink: var(--text-primary); --auth-muted: var(--text-muted); }\n.auth-main { position: relative; overflow: hidden; padding: clamp(40px, 6vw, 82px) 24px; background: linear-gradient(135deg, #f4f8ff 0%, #fff8e8 100%); }\n.auth-shell { position: relative; z-index: 1; width: min(1160px, 100%); margin: auto; display: grid; grid-template-columns: minmax(0, .88fr) minmax(480px, 1fr); align-items: start; gap: clamp(36px, 7vw, 92px); }\n.auth-shell > * { min-width: 0; max-width: 100%; }\n.auth-story { padding: 38px 0 24px; }\n.auth-story__mark, .auth-eyebrow { display: inline-flex; align-items: center; gap: 8px; color: var(--auth-blue); font-size: .76rem; font-weight: 900; letter-spacing: .11em; }\n.auth-story h1 { max-width: 590px; margin: 20px 0 18px; color: var(--auth-blue-deep); font: 900 clamp(2.35rem, 4.2vw, 3.65rem)/1.08 var(--font-display); letter-spacing: -.035em; overflow-wrap: break-word; }\n.auth-story h1 em { color: var(--auth-red); font-style: normal; }\n.auth-story > p { max-width: 490px; color: var(--auth-muted); font-size: 1.08rem; line-height: 1.7; }\n.auth-trust { display: grid; gap: 14px; margin-top: 36px; }\n.auth-trust > div { display: flex; align-items: flex-start; gap: 14px; }\n.auth-trust > div > span { display: grid; flex: 0 0 38px; width: 38px; height: 38px; place-items: center; border-radius: 12px; background: #e5efff; color: var(--auth-blue); font-size: 1.2rem; font-weight: 900; }\n.auth-trust p { display: grid; gap: 3px; margin: 0; }\n.auth-trust strong { color: var(--auth-ink); font-size: .96rem; }\n.auth-trust small { color: var(--auth-muted); font-size: .9rem; line-height: 1.45; }\n.auth-story__switch { margin-top: 32px; color: var(--auth-muted); font-size: .94rem; }\n.auth-story__switch a, .auth-form__foot a { color: var(--auth-blue); font-weight: 800; text-decoration: underline; text-underline-offset: 3px; }\n.auth-card { padding: clamp(24px, 3vw, 38px); border: 1px solid #dce5f4; border-radius: 18px; background: #fff; box-shadow: 0 16px 44px rgb(26 53 101 / 9%); }\n.auth-card--register { padding-block: 30px; }\n.auth-card__head { margin-bottom: 24px; }\n.auth-card__head > span { color: var(--auth-blue); font-size: .74rem; font-weight: 900; letter-spacing: .1em; }\n.auth-card__head h2 { margin: 7px 0 4px; color: var(--auth-ink); font: 900 1.65rem/1.25 var(--font-display); }\n.auth-card__head p { margin: 0; color: var(--auth-muted); }\n.auth-form { display: grid; gap: 17px; }\n.auth-form__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; gap: 16px 14px; }\n.auth-field { display: grid; min-width: 0; gap: 7px; color: var(--auth-ink); font-size: .9rem; font-weight: 800; }\n.auth-field > span { line-height: 1.35; }\n.auth-field input, .auth-field select { width: 100%; min-width: 0; height: 46px; padding: 0 13px; border: 1px solid #cbd6e8; border-radius: 9px; background: #fff; font: 600 .95rem var(--font-ui); }\n.auth-field input:focus, .auth-field select:focus { border-color: var(--auth-blue); outline: 3px solid rgb(19 70 160 / 16%); }\n.auth-field input::placeholder { color: #8995a9; font-weight: 500; }\n.auth-field small { color: var(--auth-muted); font-size: .8rem; font-weight: 500; line-height: 1.4; }\n.auth-field--full { grid-column: 1 / -1; }\n.auth-field--nested { margin-top: 12px; }\n.auth-password { position: relative; }\n.auth-password input { padding-right: 48px; }\n.auth-password button { position: absolute; top: 4px; right: 4px; display: grid; width: 38px; height: 38px; place-items: center; border-radius: 7px; background: transparent; color: #56627a; cursor: pointer; }\n.auth-password button:hover { background: #f0f4fb; }\n.auth-form__meta { display: flex; justify-content: space-between; align-items: center; gap: 12px; }\n.auth-check { display: inline-flex; align-items: center; gap: 8px; color: var(--auth-muted); font-size: .85rem; font-weight: 600; }\n.auth-check input { flex: 0 0 17px; width: 17px; height: 17px; padding: 0; border-radius: 3px; appearance: auto; accent-color: var(--auth-blue); }\n.auth-text-button { padding: 4px 0; background: transparent; color: var(--auth-blue); font: 800 .86rem var(--font-ui); cursor: pointer; }\n.auth-button { display: inline-flex; min-height: 48px; align-items: center; justify-content: center; padding: 10px 18px; border-radius: 9px; font: 900 1rem var(--font-ui); cursor: pointer; transition: transform 150ms ease, background-color 150ms ease; }\n.auth-button:hover { transform: translateY(-1px); }\n.auth-button--primary { width: 100%; background: var(--auth-blue); color: white; }\n.auth-button--primary:hover { background: var(--auth-blue-deep); }\n.auth-button:disabled { opacity: .55; cursor: not-allowed; transform: none; }\n.auth-providers { display: grid; gap: 10px; }\n.auth-providers button { display: flex; min-height: 46px; align-items: center; justify-content: center; gap: 10px; border: 1px solid #d6dfed; border-radius: 9px; background: #fff; color: #24314a; font: 800 .91rem var(--font-ui); cursor: pointer; transition: border-color 140ms ease, background 140ms ease; }\n.auth-providers button:hover { border-color: #94acd2; background: #f8faff; }\n.auth-providers button:nth-child(1) > svg { color: #4285f4; }\n.auth-providers button:nth-child(2) > svg { color: #1877f2; }\n.auth-providers button:nth-child(3) > svg { color: var(--auth-blue); }\n.auth-providers button:disabled { opacity: .5; cursor: not-allowed; }\n.auth-divider { display: flex; align-items: center; gap: 12px; color: #77839a; font-size: .82rem; text-align: center; }\n.auth-divider::before, .auth-divider::after { height: 1px; flex: 1; background: #e0e6ef; content: ''; }\n.auth-divider--manual { margin: 18px 0; }\n.auth-quick > p { margin: 0 0 10px; color: var(--auth-blue); font-size: .74rem; font-weight: 900; letter-spacing: .1em; }\n.auth-provider-state { display: flex; align-items: flex-start; gap: 9px; margin-bottom: 19px; padding: 12px 13px; border: 1px solid #b9dfcc; border-radius: 9px; background: #edf9f1; color: #216b49; font-size: .87rem; line-height: 1.45; }\n.auth-provider-state svg { flex: 0 0 auto; }\n.auth-verification { color: #9a6412 !important; }\n.auth-verification.is-verified { color: var(--status-success) !important; }\n.auth-message { margin: 0; padding: 10px 12px; border-radius: 8px; font-size: .9rem; line-height: 1.45; }\n.auth-message--error { border: 1px solid #f3b7bd; background: #fff0f1; color: #a32332; }\n.auth-form__foot { margin: 0; color: var(--auth-muted); font-size: .9rem; text-align: center; }\n.auth-demo-account { margin: -6px 0 0; color: #78859b; font-size: .77rem; text-align: center; }\n.auth-check-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 9px 12px; padding: 12px; border: 1px solid #dbe3ef; border-radius: 9px; background: #fafcff; }\n.auth-nested-input { margin-top: 9px; }\n.auth-modal-backdrop { position: fixed; z-index: 1000; inset: 0; display: grid; overflow-y: auto; place-items: center; padding: 18px; background: rgb(17 32 58 / 56%); }\n.auth-modal { position: relative; width: min(460px, 100%); padding: 32px; border: 1px solid #dce5f4; border-radius: 16px; background: #fff; box-shadow: 0 24px 80px rgb(0 0 0 / 25%); }\n.auth-modal__close { position: absolute; top: 12px; right: 12px; display: grid; width: 40px; height: 40px; place-items: center; border-radius: 8px; background: #f1f5fb; color: #39465d; cursor: pointer; }\n.auth-modal__icon { display: grid; width: 46px; height: 46px; place-items: center; border-radius: 13px; background: #eaf2ff; color: var(--auth-blue); }\n.auth-modal .auth-eyebrow { margin: 20px 0 6px; }\n.auth-modal h2 { margin: 0 0 8px; color: var(--auth-ink); font: 900 1.55rem/1.2 var(--font-display); }\n.auth-modal > p:not(.auth-eyebrow):not(.auth-message) { color: var(--auth-muted); line-height: 1.55; }\n.auth-modal .auth-field { margin: 20px 0 14px; }\n.auth-demo-note { display: block; margin: -7px 0 14px; color: var(--auth-muted); }\n.auth-modal__actions { display: flex; justify-content: space-between; gap: 12px; margin-top: 14px; }\n.auth-modal__actions button { display: inline-flex; align-items: center; gap: 5px; padding: 8px 0; background: transparent; color: var(--auth-blue); font: 700 .84rem var(--font-ui); cursor: pointer; }\n.auth-modal__actions button:disabled { color: #75829a; cursor: default; }\n@media (max-width: 1000px) { .auth-shell { grid-template-columns: minmax(0, .78fr) minmax(430px, 1fr); gap: 35px; } .auth-story h1 { font-size: clamp(2.2rem, 4vw, 3rem); } }\n@media (max-width: 900px) { .auth-shell { width: min(680px, 100%); grid-template-columns: 1fr; gap: 20px; } .auth-story { padding-top: 4px; } .auth-story h1 { max-width: 640px; font-size: clamp(2.1rem, 5vw, 3rem); } }\n@media (max-width: 767px) { .auth-main { padding: 30px 16px 42px; } .auth-shell { width: min(560px, 100%); grid-template-columns: 1fr; gap: 20px; } .auth-story { min-width: 0; padding: 5px 2px 0; } .auth-story h1 { max-width: 100%; margin: 13px 0 10px; font-size: clamp(2rem, 9vw, 2.8rem); } .auth-story > p { margin: 0; font-size: .98rem; } .auth-trust { grid-template-columns: 1fr; gap: 13px; margin-top: 20px; } .auth-trust > div { gap: 9px; } .auth-trust > div > span { flex-basis: 32px; width: 32px; height: 32px; } .auth-trust small { font-size: .79rem; } .auth-story__switch { margin-top: 16px; } .auth-card, .auth-card--register { width: 100%; min-width: 0; padding: 22px 18px; border-radius: 14px; } .auth-card__head { margin-bottom: 20px; } .auth-card__head h2 { font-size: 1.45rem; } .auth-form__grid { min-width: 0; grid-template-columns: 1fr; gap: 14px; } .auth-field--full { grid-column: auto; } .auth-check-grid { grid-template-columns: 1fr 1fr; } .auth-providers button { min-width: 0; padding-inline: 10px; } .auth-form__foot { text-wrap: balance; } }\n@media (max-width: 420px) { .auth-trust { grid-template-columns: 1fr; } .auth-check-grid { grid-template-columns: 1fr; } .auth-form__meta { align-items: flex-start; flex-direction: column; } .auth-modal { padding: 26px 20px; } .auth-modal__actions { flex-direction: column; align-items: flex-start; } }\n@media (prefers-reduced-motion: reduce) { .auth-button, .auth-providers button { transition: none; } }\n"],["STYLE",{},".learner-flow {\r\n  background: var(--surface-page);\r\n}\r\n\r\n.learner-flow__band {\r\n  margin-top: -86px;\r\n  padding: 158px 0 55px;\r\n  background: linear-gradient(110deg, #1748a9, #315dca);\r\n  color: #fff;\r\n}\r\n\r\n.learner-flow__band .public-kicker {\r\n  color: var(--brand-accent-yellow);\r\n}\r\n\r\n.learner-flow__band h1 {\r\n  margin: 0 0 7px;\r\n  font-size: clamp(34px, 4vw, 50px);\r\n}\r\n\r\n.learner-flow__band p {\r\n  margin: 0;\r\n  color: #eaf0ff;\r\n}\r\n\r\n.learner-flow__main {\r\n  min-height: 55vh;\r\n  padding-top: 28px;\r\n  padding-bottom: 80px;\r\n}\r\n\r\n.flow-back {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  margin: 0 0 24px;\r\n  color: var(--brand-primary);\r\n  font-weight: 800;\r\n}\r\n\r\n/* ==================================================\r\n   FLOW DETAIL - GIỮ NGUYÊN LAYOUT 2 CỘT CŨ\r\n   ================================================== */\r\n\r\n.learner-flow__detail,\r\n.flow-detail-panel {\r\n  display: grid;\r\n  grid-template-columns:\r\n    minmax(0, 1.45fr)\r\n    minmax(280px, 0.55fr);\r\n\r\n  align-items: start;\r\n  gap: 24px;\r\n}\r\n\r\n.learner-flow__profile {\r\n  min-width: 0;\r\n  padding: 28px;\r\n  border: 1px solid var(--border-default-color);\r\n  border-radius: var(--radius-lg);\r\n  background: var(--surface-white);\r\n}\r\n\r\n.learner-flow__profile-head {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 24px;\r\n}\r\n\r\n.learner-flow__portrait {\r\n  display: grid;\r\n  place-items: center;\r\n  flex: none;\r\n\r\n  width: 160px;\r\n  height: 170px;\r\n\r\n  overflow: hidden;\r\n\r\n  border-radius: var(--radius-md);\r\n\r\n  background: var(--surface-light-blue);\r\n  color: var(--brand-primary);\r\n}\r\n\r\n.learner-flow__portrait img,\r\n.learner-flow__portrait span {\r\n  grid-area: 1 / 1;\r\n}\r\n\r\n.learner-flow__portrait img {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n}\r\n\r\n.learner-flow__portrait img[hidden] {\r\n  display: none;\r\n}\r\n\r\n.learner-flow__portrait img:not([hidden]) + span {\r\n  display: none;\r\n}\r\n\r\n.learner-flow__portrait span {\r\n  font-size: 46px;\r\n  font-weight: 900;\r\n}\r\n\r\n.learner-flow__subject {\r\n  display: inline-block;\r\n  margin-top: 8px;\r\n  color: var(--brand-primary);\r\n}\r\n\r\n.learner-flow__about {\r\n  padding-top: 8px;\r\n  border-top: var(--border-default);\r\n}\r\n\r\n.learner-flow__about h3 {\r\n  margin: 22px 0 6px;\r\n  font-size: 19px;\r\n}\r\n\r\n.learner-flow__about p {\r\n  margin: 0;\r\n}\r\n\r\n.learner-flow__request {\r\n  padding: 28px;\r\n\r\n  border: 1px solid var(--border-default-color);\r\n  border-radius: var(--radius-lg);\r\n\r\n  background: var(--surface-warm);\r\n}\r\n\r\n.learner-flow__request h3 {\r\n  margin: 12px 0;\r\n  font-size: 25px;\r\n}\r\n\r\n.learner-flow__request p {\r\n  color: var(--text-muted);\r\n}\r\n\r\n.learner-flow__request .learner-flow__actions {\r\n  display: grid;\r\n}\r\n\r\n.learner-flow__request .public-btn {\r\n  justify-content: center;\r\n}\r\n\r\n.learner-flow__detail h2 {\r\n  margin: 13px 0 4px;\r\n  font-size: 33px;\r\n}\r\n\r\n.learner-flow__detail p {\r\n  color: var(--text-muted);\r\n}\r\n\r\n.learner-flow__facts {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 10px;\r\n  margin: 20px 0;\r\n}\r\n\r\n.learner-flow__facts span {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 5px;\r\n\r\n  padding: 7px 10px;\r\n\r\n  border-radius: 7px;\r\n\r\n  background: #edf5ff;\r\n\r\n  font-size: 13px;\r\n  font-weight: 800;\r\n}\r\n\r\n.learner-flow__fee {\r\n  margin: 20px 0;\r\n\r\n  color: #174dac;\r\n\r\n  font-size: 25px;\r\n  font-weight: 900;\r\n}\r\n\r\n.learner-flow__fee small {\r\n  color: var(--text-muted);\r\n  font-size: 14px;\r\n}\r\n\r\n.learner-flow__actions {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 10px;\r\n}\r\n\r\n.learner-flow__section {\r\n  margin-top: 48px;\r\n}\r\n\r\n.learner-flow__section h2 {\r\n  font-size: 30px;\r\n}\r\n\r\n.learner-flow__three {\r\n  display: grid;\r\n  grid-template-columns: repeat(3, 1fr);\r\n  gap: 16px;\r\n}\r\n\r\n.learner-flow__three span {\r\n  padding: 20px;\r\n\r\n  border-radius: 12px;\r\n\r\n  background: #eaf4ff;\r\n}\r\n\r\n.learner-flow__three strong {\r\n  display: block;\r\n\r\n  margin-bottom: 10px;\r\n\r\n  color: var(--brand-accent-red);\r\n\r\n  font-size: 22px;\r\n}\r\n\r\n/* ==================================================\r\n   FORMS\r\n   ================================================== */\r\n\r\n.learner-flow__form-grid,\r\n.tutor-flow__grid {\r\n  display: grid;\r\n  grid-template-columns:\r\n    minmax(0, 1.25fr)\r\n    minmax(250px, 0.75fr);\r\n\r\n  align-items: start;\r\n  gap: 25px;\r\n}\r\n\r\n.flow-form {\r\n  display: grid;\r\n  gap: 17px;\r\n\r\n  max-width: 760px;\r\n\r\n  padding: 28px;\r\n\r\n  border: 1px solid var(--border-default-color);\r\n  border-radius: 18px;\r\n\r\n  background: #fff;\r\n}\r\n\r\n.flow-form h2 {\n  margin: 0 0 4px;\r\n  font-size: 26px;\r\n}\r\n\r\n.flow-form label {\r\n  display: grid;\r\n  gap: 7px;\r\n\r\n  font-size: 14px;\r\n  font-weight: 800;\r\n}\r\n\r\n.flow-form input,\r\n.flow-form select,\r\n.flow-form textarea,\r\n.flow-search input {\r\n  width: 100%;\r\n  min-height: 45px;\r\n\r\n  padding: 9px 12px;\r\n\r\n  border: 1px solid #cbd8ea;\r\n  border-radius: 9px;\r\n\r\n  background: #fff;\r\n\r\n  font: inherit;\r\n}\r\n\r\n.flow-form textarea {\r\n  resize: vertical;\r\n}\r\n\r\n.flow-form button {\r\n  width: max-content;\r\n}\r\n\r\n.flow-form small {\r\n  color: var(--text-muted);\r\n}\r\n\r\n.flow-summary {\r\n  padding: 25px;\r\n\r\n  border-radius: 18px;\r\n\r\n  background: var(--surface-warm);\r\n}\r\n\r\n.flow-summary h3 {\r\n  font-size: 25px;\r\n}\r\n\r\n.flow-summary p {\r\n  color: var(--text-muted);\r\n}\r\n\r\n.flow-summary strong {\r\n  color: #144aa9;\r\n  font-size: 21px;\r\n}\r\n\r\n/* ==================================================\r\n   TOOLBAR / LIST\r\n   ================================================== */\r\n\r\n.flow-toolbar {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n\r\n  gap: 15px;\r\n\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.flow-tabs {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 7px;\r\n}\r\n\r\n.flow-tabs button {\r\n  min-height: 40px;\r\n\r\n  padding: 8px 13px;\r\n\r\n  border-radius: 8px;\r\n\r\n  background: #eaf1fb;\r\n  color: #435570;\r\n\r\n  font-weight: 800;\r\n}\r\n\r\n.flow-tabs button.is-active {\r\n  background: #1954b9;\r\n  color: #fff;\r\n}\r\n\r\n.flow-list {\r\n  border-top: 1px solid #dce6f3;\r\n}\r\n\r\n.flow-row {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 13px;\r\n\r\n  min-height: 78px;\r\n\r\n  padding: 15px 12px;\r\n\r\n  border-bottom: 1px solid #dce6f3;\r\n\r\n  background: #fff;\r\n}\r\n\r\n.flow-row > span:nth-child(2) {\r\n  display: grid;\r\n  gap: 4px;\r\n\r\n  min-width: 0;\r\n\r\n  flex: 1;\r\n}\r\n\r\n.flow-row strong {\r\n  font-size: 15px;\r\n}\r\n\r\n.flow-row small {\r\n  color: var(--text-muted);\r\n  font-size: 13px;\r\n}\r\n\r\n.flow-row__icon {\r\n  display: grid;\r\n  place-items: center;\r\n\r\n  flex: none;\r\n\r\n  width: 42px;\r\n  height: 42px;\r\n\r\n  border-radius: 10px;\r\n\r\n  background: #e8f1ff;\r\n  color: #1a55b5;\r\n}\r\n\r\n.flow-status {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 5px;\r\n\r\n  width: max-content;\r\n\r\n  padding: 6px 10px;\r\n\r\n  border-radius: 30px;\r\n\r\n  background: #e6f1ff;\r\n  color: #1951a4;\r\n\r\n  font-size: 12px;\r\n  font-weight: 900;\r\n\r\n  white-space: nowrap;\r\n}\r\n\r\n/* ==================================================\r\n   REQUEST DETAIL\r\n   BỐ CỤC CŨ:\r\n   trái = thông tin\r\n   phải = phản hồi\r\n   ================================================== */\r\n\r\n.flow-detail-panel {\r\n  grid-template-columns:\r\n    minmax(0, 1.4fr)\r\n    minmax(230px, 0.6fr);\r\n\r\n  padding: 28px;\r\n\r\n  border: 1px solid var(--border-default-color);\r\n  border-radius: var(--radius-lg);\r\n\r\n  background: var(--surface-white);\r\n}\r\n\r\n.flow-detail-panel h2 {\r\n  margin: 17px 0 8px;\r\n  font-size: 27px;\r\n}\r\n\r\n.flow-detail-panel p {\r\n  color: var(--text-muted);\r\n}\r\n\r\n.flow-detail-panel dl {\r\n  display: grid;\r\n  gap: 12px;\r\n\r\n  margin-top: 25px;\r\n}\r\n\r\n.flow-detail-panel dl div {\r\n  display: flex;\r\n  justify-content: space-between;\r\n\r\n  gap: 16px;\r\n\r\n  border-bottom: 1px solid #e4ebf5;\r\n}\r\n\r\n.flow-detail-panel dt {\r\n  color: var(--text-muted);\r\n}\r\n\r\n.flow-detail-panel dd {\r\n  margin: 0;\r\n\r\n  font-weight: 800;\r\n\r\n  text-align: right;\r\n}\r\n\r\n/*\r\n * Khung xanh bên phải.\r\n * Giữ đúng layout cũ.\r\n */\r\n.flow-detail-panel aside {\r\n  padding: 20px;\r\n\r\n  border-radius: 13px;\r\n\r\n  background: #eff6ff;\r\n}\r\n\r\n.flow-detail-panel aside h3 {\r\n  margin: 0 0 10px;\r\n}\r\n\r\n.flow-action-stack {\r\n  display: grid;\r\n  gap: 9px;\r\n}\r\n\r\n.flow-review {\r\n  margin-top: 24px;\r\n}\r\n\r\n.flow-success {\n  color: var(--status-success) !important;\r\n  font-weight: 800;\r\n}\r\n\r\n/* ==================================================\r\n   BẢNG THỜI GIAN MONG MUỐN\r\n   PHẦN MỚI DUY NHẤT CỦA DETAIL\r\n   ================================================== */\r\n\r\n.request-preferred-times {\r\n  margin-top: 28px;\r\n}\r\n\r\n.request-preferred-times h3 {\r\n  margin: 0 0 12px;\r\n\r\n  font-size: 1rem;\r\n}\r\n\r\n/*\r\n * Bảng chỉ nằm trong cột trái.\r\n * Không tác động sang aside.\r\n */\r\n.request-preferred-times__table-wrap {\r\n  width: 100%;\r\n\r\n  overflow: hidden;\r\n\r\n  border: 1px solid var(--border-default-color);\r\n  border-radius: 10px;\r\n\r\n  background: var(--surface-white);\r\n}\r\n\r\n.request-preferred-times__table {\r\n  width: 100%;\r\n\r\n  border-collapse: collapse;\r\n  table-layout: fixed;\r\n}\r\n\r\n.request-preferred-times__table th {\r\n  padding: 9px 12px;\r\n\r\n  background: var(--surface-page);\r\n\r\n  color: var(--text-muted);\r\n\r\n  font-size: 0.78rem;\r\n  font-weight: 800;\r\n\r\n  text-align: left;\r\n}\r\n\r\n.request-preferred-times__table th:last-child {\r\n  width: 155px;\r\n\r\n  text-align: right;\r\n}\r\n\r\n.request-preferred-times__table td {\r\n  padding: 10px 12px;\r\n\r\n  border-top: 1px solid #e4ebf5;\r\n\r\n  vertical-align: middle;\r\n}\r\n\r\n.request-preferred-times__table td:first-child {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n\r\n.request-preferred-times__table td:first-child strong {\r\n  font-size: 0.88rem;\r\n}\r\n\r\n.request-preferred-times__table td:first-child span {\r\n  color: var(--text-muted);\r\n  font-size: 0.78rem;\r\n}\r\n\r\n.request-preferred-times__table td:last-child {\r\n  color: var(--brand-primary);\r\n\r\n  font-weight: 800;\r\n  font-variant-numeric: tabular-nums;\r\n\r\n  text-align: right;\r\n\r\n  white-space: nowrap;\r\n}\r\n\r\n/* ==================================================\r\n   TUTOR\r\n   ================================================== */\r\n\r\n.tutor-flow__panel {\r\n  padding: 25px;\r\n\r\n  border: 1px solid #dfe7f2;\r\n  border-radius: 16px;\r\n\r\n  background: #fff;\r\n}\r\n\r\n.tutor-flow__panel-head {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: start;\r\n\r\n  gap: 20px;\r\n\r\n  margin-bottom: 15px;\r\n\r\n  color: #1852af;\r\n}\r\n\r\n.tutor-flow__panel-head h2 {\r\n  margin: 0 0 4px;\r\n\r\n  color: var(--text-primary);\r\n}\r\n\r\n.tutor-flow__panel-head p {\r\n  margin: 0;\r\n\r\n  color: var(--text-muted);\r\n}\r\n\r\n.tutor-flow__panel .flow-row {\r\n  background: transparent;\r\n}\r\n\r\n.tutor-flow__panel > .text-link {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n\r\n  margin-top: 20px;\r\n}\r\n\r\n.flow-search {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 7px;\r\n\r\n  min-width: 220px;\r\n}\r\n\r\n.flow-search input {\r\n  min-width: 0;\r\n}\r\n\r\n.tutor-flow .flow-detail-panel {\r\n  padding: 25px;\r\n}\r\n\r\n.tutor-flow .flow-summary {\r\n  background: #eaf3ff;\r\n}\r\n\r\n.workspace-topbar__actions {\r\n  margin-left: auto;\r\n}\r\n\r\n/* ==================================================\r\n   RESPONSIVE\r\n   ================================================== */\r\n\r\n@media (max-width: 900px) {\r\n  .learner-flow__band {\r\n    margin-top: -72px;\r\n    padding-top: 140px;\r\n  }\r\n\r\n  .learner-flow__detail,\r\n  .learner-flow__form-grid,\r\n  .tutor-flow__grid {\r\n    grid-template-columns: 1fr;\r\n  }\r\n\r\n  .flow-toolbar {\r\n    align-items: start;\r\n  }\r\n\r\n  .flow-detail-panel {\r\n    grid-template-columns: 1fr;\r\n  }\r\n}\r\n\r\n@media (max-width: 767px) {\r\n  .learner-flow__main {\r\n    padding-bottom: 55px;\r\n  }\r\n\r\n  .learner-flow__detail,\r\n  .flow-detail-panel {\r\n    grid-template-columns: 1fr;\r\n  }\r\n\r\n  .learner-flow__profile,\r\n  .learner-flow__request,\r\n  .flow-detail-panel {\r\n    padding: 18px;\r\n  }\r\n\r\n  .learner-flow__profile-head {\r\n    align-items: start;\r\n    gap: 15px;\r\n  }\r\n\r\n  .learner-flow__portrait {\r\n    width: 100px;\r\n    height: 120px;\r\n  }\r\n\r\n  .learner-flow__portrait span {\r\n    font-size: 32px;\r\n  }\r\n\r\n  .learner-flow__profile h2 {\r\n    font-size: 24px;\r\n  }\r\n\r\n  .learner-flow__three {\r\n    grid-template-columns: 1fr;\r\n  }\r\n\r\n  .flow-form {\r\n    padding: 20px;\r\n  }\r\n\r\n  .flow-toolbar {\r\n    display: grid;\r\n  }\r\n\r\n  .flow-tabs {\r\n    overflow-x: auto;\r\n    flex-wrap: nowrap;\r\n\r\n    padding-bottom: 5px;\r\n  }\r\n\r\n  .flow-tabs button {\r\n    white-space: nowrap;\r\n  }\r\n\r\n  .flow-row {\r\n    flex-wrap: wrap;\r\n  }\r\n\r\n  .flow-row .flow-status,\r\n  .flow-row .badge {\n    margin-left: 55px;\n  }\n\n  /* Keep the operational request title readable; status gets its own row. */\n  .tutor-flow .flow-row {\n    display: grid;\n    grid-template-columns: 40px minmax(0, 1fr) 20px;\n    align-items: start;\n  }\n\n  .tutor-flow .flow-row .badge {\n    grid-column: 2;\n    grid-row: 2;\n    justify-self: start;\n    margin-left: 0;\n  }\n\n  .tutor-flow .flow-row > svg:last-child {\n    grid-column: 3;\n    grid-row: 1;\n  }\n\r\n  .flow-detail-panel dl div {\r\n    display: grid;\r\n    gap: 2px;\r\n  }\r\n\r\n  .flow-detail-panel dd {\r\n    text-align: left;\r\n  }\r\n\r\n  .tutor-flow__panel {\r\n    padding: 16px;\r\n  }\r\n\r\n  .flow-search {\r\n    width: 100%;\r\n  }\r\n\r\n  .request-preferred-times__table th,\r\n  .request-preferred-times__table td {\r\n    padding: 9px;\r\n  }\r\n\r\n  .request-preferred-times__table th:last-child {\r\n    width: 125px;\r\n  }\r\n\r\n  .request-preferred-times__table td:first-child {\r\n    display: grid;\r\n    gap: 2px;\r\n  }\r\n}\r\n\r\n@media (max-width: 480px) {\r\n  .learner-flow__profile-head {\r\n    display: block;\r\n  }\r\n\r\n  .learner-flow__portrait {\r\n    margin-bottom: 16px;\r\n  }\r\n\r\n  .learner-flow__profile-head .flow-status {\r\n    white-space: normal;\r\n  }\r\n}\n\n.tutor-flow .flow-error {\n  color: var(--color-danger);\n  font-weight: 800;\n}\n\n.tutor-level-options { margin: 0; padding: var(--space-4); border: var(--border-default); border-radius: var(--radius-sm); }\n.tutor-level-options legend { padding-inline: var(--space-1); font-weight: 800; }\n.tutor-level-options p { margin: 0 0 var(--space-3); color: var(--text-muted); font-size: var(--text-compact); }\n.tutor-level-options > div { display: flex; flex-wrap: wrap; gap: var(--space-2); }\n.flow-form .tutor-level-options label { display: flex; align-items: center; gap: var(--space-2); min-height: 44px; padding: var(--space-2) var(--space-3); border: var(--border-default); border-radius: var(--radius-sm); cursor: pointer; }\n.flow-form .tutor-level-options input { width: 18px; min-height: 18px; height: 18px; margin: 0; padding: 0; accent-color: var(--brand-primary); }\n.tutor-level-options label:has(input:checked) { background: var(--surface-light-blue); border-color: var(--brand-primary); color: var(--brand-primary); }\n"]],"\n  ",["BODY",{},"\n    ",["DIV",{"id":"root"},["DIV",{"class":"public-page auth-page"},["HEADER",{"class":"public-header","id":"top"},["DIV",{"class":"public-header__inner"},["A",{"class":"public-brand","aria-label":"TutorNearMe — trang chủ","href":"/","data-discover":"true"},["SPAN",{"class":"public-brand__mark"},"TN"],["SPAN",{},["STRONG",{},"TutorNearMe"],["SMALL",{},"Gia sư gần bạn"]]],["NAV",{"class":"public-nav ","aria-label":"Điều hướng chính"},["A",{"href":"/#finder"},"Tìm gia sư"],["A",{"href":"/#needs"},"Nhu cầu học"],["A",{"href":"/#tutors"},"Gia sư nổi bật"],["A",{"href":"/#offers"},"Ưu đãi"],["A",{"href":"/#stories"},"Góc học tập"],["DIV",{"class":"public-nav__mobile"},["A",{"href":"/tutor","data-discover":"true"},"Trở thành gia sư"],["A",{"href":"/learner/search","data-discover":"true"},"Khám phá gia sư"],["A",{"href":"/login","data-discover":"true"},"Đăng nhập"],["A",{"href":"/register","data-discover":"true"},"Đăng ký"]]],["DIV",{"class":"public-header__actions"},["A",{"class":"public-header__yellow"