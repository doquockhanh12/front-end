--motion-fast), transform var(--motion-fast); }\n.button:active { transform: translateY(1px); }\n.button--primary { background: var(--color-brand); color: var(--color-surface); }\n.button--primary:hover { background: var(--color-brand-dark); }\n.button--secondary { border-color: var(--color-border-strong); background: var(--color-surface); color: var(--color-ink); }\n.button--secondary:hover { border-color: var(--color-brand); color: var(--color-brand); }\n.button--quiet { background: transparent; color: var(--color-text-secondary); }\n.button--quiet:hover { background: var(--color-surface-muted); color: var(--color-ink); }\n.button--sm { min-height: 36px; padding: 7px 12px; font-size: .875rem; }\n.button--xs { min-height: 32px; padding: 5px 11px; font-size: .82rem; }\n.icon-button { display: inline-grid; place-items: center; flex: none; width: 38px; height: 38px; border-radius: var(--radius-base); background: transparent; color: var(--color-text-secondary); transition: background var(--motion-fast), color var(--motion-fast); }\n.icon-button:hover { background: var(--color-surface-muted); color: var(--color-ink); }\n\n.search-input { display: flex; align-items: center; gap: 10px; min-width: 0; height: var(--control-height, 44px); padding: 0 13px; background: var(--color-surface); border: var(--border-default); border-radius: var(--radius-base); color: var(--color-text-muted); }\n.search-input:focus-within { outline: 2px solid var(--color-brand); outline-offset: 2px; }\n.search-input input { width: 100%; min-width: 0; height: 100%; padding: 0; border: 0; outline: 0; background: transparent; color: var(--color-ink); }\n.search-input input:focus-visible { outline: 0; }\n\n.role-switcher { display: flex; align-items: center; flex: none; gap: 2px; font-size: .79rem; white-space: nowrap; }\n.role-switcher__label { margin-right: 8px; color: var(--color-text-muted); }\n.role-switcher__link { padding: 8px 9px; border-bottom: 2px solid transparent; color: var(--color-text-secondary); transition: color var(--motion-fast), border-color var(--motion-fast); }\n.role-switcher__link:hover, .role-switcher__link.is-active { color: var(--color-brand); }\n.role-switcher__link.is-active { border-color: var(--color-brand); font-weight: 700; }\n\n.sidebar-item { display: flex; align-items: center; gap: 12px; min-height: 42px; padding: 9px 12px; border-radius: var(--radius-md); color: var(--color-text-secondary); font-size: .9rem; font-weight: 600; transition: background var(--motion-fast), color var(--motion-fast); }\n.sidebar-item:hover { background: var(--color-surface-muted); color: var(--color-ink); }\n.sidebar-item.is-active { background: var(--color-brand-light); color: var(--color-brand); font-weight: 700; }\n.sidebar-item--unavailable { cursor: default; }\n.sidebar-item--unavailable:hover { background: transparent; color: var(--color-text-secondary); }\n.sidebar-item__count { display: grid; place-items: center; min-width: 21px; height: 21px; margin-left: auto; padding: 0 5px; border-radius: var(--radius-sm); background: var(--color-warning-bg); color: var(--color-warning); font-size: .72rem; }\n.sidebar-section-label { display: block; margin: 20px 12px 8px; color: var(--color-text-muted); font-size: .68rem; font-weight: 700; letter-spacing: .13em; }\n\n.stat-item { min-width: 0; padding: 16px 20px; border-right: var(--border-default); }\n.stat-item:last-child { border-right: 0; }\n.stat-item__top { display: flex; align-items: center; justify-content: space-between; gap: 8px; color: var(--color-text-secondary); font-size: .83rem; font-weight: 600; }\n.stat-item__top svg { color: var(--color-brand); }\n.stat-item > strong { display: block; margin: 6px 0 2px; font-size: 1.85rem; line-height: 1.1; letter-spacing: -.04em; font-variant-numeric: tabular-nums; }\n.stat-item__note { color: var(--color-text-muted); font-size: .8rem; }\n\n.workspace { display: grid; min-height: 100vh; }\n.workspace__main { min-width: 0; }\n.workspace-topbar { display: 