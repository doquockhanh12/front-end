t\":350000,\"trialLessonRequested\":true,\"learningGoal\":\"Nắm vững kiến thức điện xoay chiều và dao động điều hòa\",\"status\":\"open\",\"moderationStatus\":\"approved\",\"createdAt\":\"2026-10-05T08:15:00+07:00\",\"proposalCount\":0}],\"proposals\":[{\"id\":\"prop-201\",\"classPostId\":\"post-101\",\"tutorId\":\"demo-tutor\",\"tutorName\":\"Trần Gia Bảo\",\"tutorUniversity\":\"ĐH Sư Phạm TP.HCM (Sư phạm Toán)\",\"tutorRating\":4.9,\"tutorPunctualityRate\":99,\"hasStudentBadge\":true,\"tier\":\"top_rated\",\"proposedFee\":220000,\"platformFee\":22000,\"netPayout\":198000,\"coverNote\":\"Chào phụ huynh, em là sinh viên năm 3 Sư Phạm Toán, đã có 2 năm kinh nghiệm dạy kèm toán 8-9 lấy lại căn bản rất nhanh.\",\"status\":\"pending\",\"createdAt\":\"2026-10-03T11:20:00+07:00\"},{\"id\":\"prop-202\",\"classPostId\":\"post-101\",\"tutorId\":\"mai-anh\",\"tutorName\":\"Nguyễn Mai Anh\",\"tutorUniversity\":\"ĐH Bách Khoa TP.HCM (Khoa học Máy tính)\",\"tutorRating\":4.8,\"tutorPunctualityRate\":97,\"hasStudentBadge\":true,\"tier\":\"pro\",\"proposedFee\":240000,\"platformFee\":24000,\"netPayout\":216000,\"coverNote\":\"Em có thế mạnh phương pháp tư duy logic và giải toán trắc nghiệm nhanh, sẵn sàng kèm học thử 1 buổi.\",\"status\":\"pending\",\"createdAt\":\"2026-10-03T15:40:00+07:00\"},{\"id\":\"prop-203\",\"classPostId\":\"post-102\",\"tutorId\":\"thao-vy\",\"tutorName\":\"Lê Thảo Vy\",\"tutorUniversity\":\"ĐH Ngoại Thương TP.HCM (Kinh tế Đối ngoại)\",\"tutorRating\":5,\"tutorPunctualityRate\":100,\"hasStudentBadge\":true,\"tier\":\"top_rated\",\"proposedFee\":250000,\"platformFee\":17500,\"netPayout\":232500,\"coverNote\":\"IELTS 8.0, kinh nghiệm luyện thi vào lớp 10 các trường chuyên Lê Hồng Phong, Trần Đại Nghĩa.\",\"status\":\"pending\",\"createdAt\":\"2026-10-04T16:10:00+07:00\"}],\"chatThreads\":[{\"id\":\"thread-001\",\"learnerId\":\"demo-learner\",\"tutorId\":\"demo-tutor\",\"learnerName\":\"Nguyễn Minh Anh\",\"tutorName\":\"Trần Gia Bảo\",\"lastMessageText\":\"Gi